{
  "name": "caisheng-multichat",
  "version": "1.0.0",
  "private": true,
  "author": "Caisheng",
  "copyright": "Copyright © 2026 Caisheng",
  "description": "财盛聚合聊天翻译平台：Signal、WhatsApp 等多平台多账号聚合与实时双语翻译",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://127.0.0.1:5173 dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "dist:win": "npm run prepare:signal && npm run verify:signal && npm run build && electron-builder --win nsis portable --x64 --publish never",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "node tests/managed-signal.cjs && node tests/translation-pipeline.cjs && node tests/translation-fallback.cjs && node tests/chat-preload.cjs && node tests/startup-failure.cjs && node tests/platform-registry.cjs",
    "prepare:signal": "node scripts/prepare-signal-runtime.cjs",
    "verify:signal": "node scripts/prepare-signal-runtime.cjs --verify",
    "predev": "npm run prepare:signal"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "38.1.0",
    "electron-builder": "26.15.3",
    "extract-zip": "2.0.1",
    "jsdom": "26.1.0",
    "tar": "7.5.22",
    "typescript": "7.0.2",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.caisheng.multichat",
    "productName": "财盛聚合聊天",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "executableName": "CaishengMultiChat",
      "target": [
        "nsis",
        "portable"
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "artifactName": "Caisheng-MultiChat-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowElevation": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "财盛聚合聊天",
      "uninstallDisplayName": "财盛聚合聊天",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "language": "2052",
      "multiLanguageInstaller": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Caisheng-MultiChat-${version}-${arch}-Portable.${ext}"
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/signal-runtime",
        "to": "signal-runtime"
      }
    ],
    "beforePack": "scripts/check-runtime.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
