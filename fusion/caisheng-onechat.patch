+export type SignalSessionId = string;
+
+export type SignalPhase =
+  | 'idle'
+  | 'starting'
+  | 'pairing'
+  | 'ready'
+  | 'retrying'
+  | 'error'
+  | 'stopped';
+
+export type SignalSessionProfile = {
+  id: SignalSessionId;
+  name: string;
+  account: string;
+  port: number;
+  dataDir: string;
+  runtimeDir: string;
+  enabled: boolean;
+  createdAt: number;
+};
+
+export type SignalStatus = {
+  sessionId: SignalSessionId;
+  phase: SignalPhase;
+  account?: string;
+  qrUri?: string;
+  code?: string;
+  message?: string;
+};
+
+export type SignalAvatar = {
+  path?: string;
+  color: string;
+  initials: string;
+};
+
+export type SignalConversation = {
+  id: string;
+  kind: 'contact' | 'group';
+  title: string;
+  subtitle: string;
+  avatar: SignalAvatar;
+  recipient?: string;
+  groupId?: string;
+  lastText?: string;
+  lastAt?: number;
+  unread?: number;
+};
+
+export type SignalMessage = {
+  id: string;
+  conversationId: string;
+  direction: 'in' | 'out';
+  sender: string;
+  text: string;
+  translatedText?: string;
+  attachments?: string[];
+  at: number;
+};
