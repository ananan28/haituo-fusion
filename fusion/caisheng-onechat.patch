+import { createHash } from 'node:crypto';
+import type { SignalAvatar, SignalConversation } from './types';
+
+const COLORS = ['#3b45fd', '#3f8cff', '#00a884', '#7b61ff', '#d95763', '#cc7a00'];
+
+function text(...values: unknown[]): string {
+  return values.find((value) => typeof value === 'string' && value.trim())?.toString().trim() ?? '';
+}
+
+export function signalAvatar(title: string, avatarPath?: string): SignalAvatar {
+  const digest = createHash('sha256').update(title).digest();
+  const words = title.trim().split(/\s+/).filter(Boolean);
+  const initials = words.length > 1
+    ? `${words[0][0]}${words.at(-1)?.[0] ?? ''}`
+    : (words[0]?.slice(0, 2) || '?');
+  return { path: avatarPath || undefined, color: COLORS[digest[0] % COLORS.length], initials: initials.toUpperCase() };
+}
+
+export function normalizeSignalContacts(raw: unknown): SignalConversation[] {
+  if (!Array.isArray(raw)) return [];
+  return raw.flatMap((contact: any) => {
+    const recipient = text(contact?.number, contact?.uuid, contact?.aci, contact?.username);
+    if (!recipient) return [];
+    const profileName = [contact?.profile?.givenName, contact?.profile?.familyName].filter(Boolean).join(' ');
+    const localName = [contact?.givenName, contact?.familyName].filter(Boolean).join(' ');
+    const title = text(contact?.name, contact?.nickName, localName, profileName, contact?.username, recipient);
+    const avatarPath = text(contact?.profile?.avatar, contact?.avatar, contact?.avatarPath);
+    return [{
+      id: `contact:${recipient}`,
+      kind: 'contact' as const,
+      title,
+      subtitle: contact?.username ? `@${contact.username} · ${recipient}` : recipient,
+      recipient,
+      avatar: signalAvatar(title, avatarPath),
+    }];
+  });
+}
+
+export function normalizeSignalGroups(raw: unknown): SignalConversation[] {
+  if (!Array.isArray(raw)) return [];
+  return raw.flatMap((group: any) => {
+    if (!group?.id || group?.isMember === false) return [];
+    const title = text(group.name, 'Signal 群组');
+    const avatarPath = text(group?.avatar, group?.avatarPath);
+    return [{
+      id: `group:${String(group.id)}`,
+      kind: 'group' as const,
+      title,
+      subtitle: `${Array.isArray(group.members) ? group.members.length : 0} 位成员`,
+      groupId: String(group.id),
+      avatar: signalAvatar(title, avatarPath),
+    }];
+  });
+}
