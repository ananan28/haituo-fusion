+jest.mock('electron', () => ({ ipcMain: { handle: jest.fn() } }));
+jest.mock('../src/electron/Settings', () => ({ default: jest.fn() }));
+
+import {
+  DEFAULT_CHAT_TRANSLATION_CONFIG,
+  translateChatText,
+} from '../src/electron/chatTranslation';
+
+const jsonResponse = (payload: unknown, ok = true) =>
+  ({
+    ok,
+    status: ok ? 200 : 500,
+    statusText: ok ? 'OK' : 'Error',
+    text: async () => JSON.stringify(payload),
+  }) as Response;
+
+describe('chat translation service', () => {
+  it('uses Google without exposing translation calls to the webview', async () => {
+    const fetchMock = jest.fn(async () => jsonResponse([[['你好', 'hello']]]));
+    const result = await translateChatText(
+      { text: 'hello', targetLanguage: 'zh-CN' },
+      { ...DEFAULT_CHAT_TRANSLATION_CONFIG, provider: 'google' },
+      fetchMock as typeof fetch,
+    );
+    expect(result).toEqual({ text: '你好', provider: 'google' });
+    expect(String(fetchMock.mock.calls[0][0])).toContain('translate.googleapis.com');
+  });
+
+  it('falls back from Google to MyMemory in automatic mode', async () => {
+    const fetchMock = jest
+      .fn()
+      .mockResolvedValueOnce(jsonResponse({ message: 'down' }, false))
+      .mockResolvedValueOnce(jsonResponse({ responseData: { translatedText: 'bonjour' } }));
+    const result = await translateChatText(
+      { text: 'hello', targetLanguage: 'fr' },
+      { ...DEFAULT_CHAT_TRANSLATION_CONFIG, provider: 'auto' },
+      fetchMock as typeof fetch,
+    );
+    expect(result).toEqual({ text: 'bonjour', provider: 'mymemory' });
+  });
+
+  it('supports an OpenAI-compatible endpoint', async () => {
+    const fetchMock = jest.fn(async () =>
+      jsonResponse({ choices: [{ message: { content: 'hola' } }] }),
+    );
+    const result = await translateChatText(
+      { text: 'hello', targetLanguage: 'es' },
+      {
+        ...DEFAULT_CHAT_TRANSLATION_CONFIG,
+        provider: 'openai',
+        openAIBaseUrl: 'https://example.test/v1/chat/completions',
+        openAIApiKey: 'secret',
+      },
+      fetchMock as typeof fetch,
+    );
+    expect(result).toEqual({ text: 'hola', provider: 'openai' });
+    expect(String(fetchMock.mock.calls[0][0])).toBe('https://example.test/v1/chat/completions');
+    expect((fetchMock.mock.calls[0][1] as RequestInit).headers).toMatchObject({
+      Authorization: 'Bearer secret',
+    });
+  });
+});
diff -ruN '--exclude=.github' '--exclude=caisheng.ico' '--exclude=caisheng.png' fusion_base/onechat-main/test/signal-managed.test.ts fusion_work/onechat-main/test/signal-managed.test.ts
--- fusion_base/onechat-main/test/signal-managed.test.ts	1970-01-01 09:00:00.000000000 +0900
+++ fusion_work/onechat-main/test/signal-managed.test.ts	2026-09-06 01:25:01.829491685 +0900
@@ -0,0 +1,79 @@
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { normalizeSignalContacts, normalizeSignalGroups } from '../src/features/signal-managed/catalog';
+import { SignalProfileStore } from '../src/features/signal-managed/profile-store';
+import { provisionSignalRuntime, signalDaemonArgs, signalRuntimeCommand } from '../src/features/signal-managed/runtime';
+
+describe('managed Signal accounts', () => {
+  let root: string;
+
+  beforeEach(() => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), 'onechat-signal-'));
+  });
+
+  afterEach(() => {
+    fs.rmSync(root, { recursive: true, force: true });
+  });
+
+  it('allocates an isolated runtime, data directory and port for every account', () => {
+    const store = new SignalProfileStore(root);
+    const first = store.create('signal-main', '工作号');
+    const second = store.create('signal-sales', '销售号');
+
+    expect(first.port).not.toBe(second.port);
+    expect(first.dataDir).not.toBe(second.dataDir);
+    expect(first.runtimeDir).not.toBe(second.runtimeDir);
+    expect(fs.existsSync(first.dataDir)).toBe(true);
+    expect(fs.existsSync(second.runtimeDir)).toBe(true);
+    expect(new SignalProfileStore(root).list()).toHaveLength(2);
+  });
+
+  it('rejects unsafe session ids and duplicate ports', () => {
+    const store = new SignalProfileStore(root);
+    expect(() => store.create('../escape')).toThrow('SIGNAL_INVALID_SESSION_ID');
+    const first = store.create('one');
+    store.create('two');
+    expect(() => store.update('two', { port: first.port })).toThrow('SIGNAL_PORT_IN_USE');
+  });
+
+  it('builds a command using only the selected account directories', () => {
+    const profile = new SignalProfileStore(root).create('one');
+    const java = path.join(profile.runtimeDir, 'jre', 'bin', process.platform === 'win32' ? 'java.exe' : 'java');
+    fs.mkdirSync(path.dirname(java), { recursive: true });
+    fs.writeFileSync(java, '');
+    fs.mkdirSync(path.join(profile.runtimeDir, 'signal-cli', 'lib'), { recursive: true });
+    fs.writeFileSync(path.join(profile.runtimeDir, 'runtime-manifest.json'), '{}');
+
+    const command = signalRuntimeCommand(profile);
+    expect(command.executable).toBe(java);
+    expect(command.cwd).toBe(profile.runtimeDir);
+    expect(signalDaemonArgs(profile)).toEqual([
+      '--config', profile.dataDir, '--scrub-log', 'daemon', '--http', `127.0.0.1:${profile.port}`,
+    ]);
+  });
+
+  it('provisions a private JRE and signal-cli tree for an account', () => {
+    const profile = new SignalProfileStore(root).create('private-runtime');
+    const template = path.join(root, 'template');
+    fs.mkdirSync(path.join(template, 'jre', 'bin'), { recursive: true });
+    fs.mkdirSync(path.join(template, 'signal-cli', 'lib'), { recursive: true });
+    fs.writeFileSync(path.join(template, 'jre', 'bin', 'java'), 'java');
+    fs.writeFileSync(path.join(template, 'signal-cli', 'lib', 'signal.jar'), 'jar');
+    fs.writeFileSync(path.join(template, 'runtime-manifest.json'), '{}');
+
+    provisionSignalRuntime(template, profile);
+
+    expect(fs.readFileSync(path.join(profile.runtimeDir, 'jre', 'bin', 'java'), 'utf8')).toBe('java');
+    expect(fs.existsSync(path.join(profile.runtimeDir, 'signal-cli', 'lib', 'signal.jar'))).toBe(true);
+  });
+
+  it('preserves Signal-style contact and group identity including avatars', () => {
+    const contacts = normalizeSignalContacts([{ number: '+8613800000000', name: '张 三', profile: { avatar: '/avatar/a' } }]);
+    const groups = normalizeSignalGroups([{ id: 'group-id', name: '项目组', members: ['a', 'b'] }]);
+
+    expect(contacts[0]).toMatchObject({ id: 'contact:+8613800000000', title: '张 三', avatar: { path: '/avatar/a', initials: '张三' } });
+    expect(groups[0]).toMatchObject({ id: 'group:group-id', title: '项目组', subtitle: '2 位成员' });
+    expect(groups[0].avatar.color).toMatch(/^#/);
+  });
+});
