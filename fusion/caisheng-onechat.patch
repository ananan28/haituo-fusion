diff -ruN '--exclude=.github' '--exclude=caisheng.ico' '--exclude=caisheng.png' fusion_base/onechat-main/src/webview/chatTranslation.ts fusion_work/onechat-main/src/webview/chatTranslation.ts
--- fusion_base/onechat-main/src/webview/chatTranslation.ts	1970-01-01 09:00:00.000000000 +0900
+++ fusion_work/onechat-main/src/webview/chatTranslation.ts	2026-09-06 01:25:19.313987694 +0900
@@ -0,0 +1,192 @@
+import { ipcRenderer } from 'electron';
+
+type TranslationConfig = {
+  enabled: boolean;
+  incomingBilingual: boolean;
+  inputMode: 'normal' | 'efficiency';
+  sourceLanguage: string;
+  incomingTargetLanguage: string;
+  outgoingTargetLanguage: string;
+};
+
+const MESSAGE_SELECTORS = [
+  // Signal Desktop / Signal-compatible surface
+  '.module-message__text',
+  '[data-testid="message-text"]',
+  // WhatsApp Web
+  '[data-pre-plain-text] .selectable-text',
+  '#main [role="row"] .selectable-text',
+  // Telegram Web
+  '.Message .text-content',
+  '.message .text-content',
+  // Generic service recipes may opt in explicitly.
+  '[data-onechat-message-text]',
+];
+
+const COMPOSER_SELECTORS = [
+  '[data-onechat-composer]',
+  '[contenteditable="true"][role="textbox"]',
+  'textarea',
+  'input[type="text"]',
+];
+
+const translated = new WeakSet<Element>();
+const translating = new WeakSet<Element>();
+let config: TranslationConfig | null = null;
+let observer: MutationObserver | null = null;
+
+function isOutgoingMessage(element: HTMLElement): boolean {
+  const container = element.closest<HTMLElement>(
+    '.message-out, .own, .is-outgoing, [data-message-author="self"], [data-is-outgoing="true"], [data-onechat-direction="outgoing"]',
+  );
+  if (container) return true;
+  // Signal's class names have changed over time, but consistently retain "outgoing".
+  for (let current: HTMLElement | null = element; current && current !== document.body; current = current.parentElement) {
+    if (/outgoing/i.test(current.className)) return true;
+  }
+  return false;
+}
+
+function editableText(element: HTMLElement): string {
+  return element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement
+    ? element.value
+    : element.innerText || element.textContent || '';
+}
+
+function replaceEditableText(element: HTMLElement, value: string): void {
+  element.focus();
+  if (element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement) {
+    const prototype = element instanceof HTMLTextAreaElement ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
+    const setter = Object.getOwnPropertyDescriptor(prototype, 'value')?.set;
+    setter?.call(element, value);
+    element.dispatchEvent(new Event('input', { bubbles: true }));
+    element.dispatchEvent(new Event('change', { bubbles: true }));
+    element.setSelectionRange(value.length, value.length);
+    return;
+  }
+  // execCommand keeps React-controlled contenteditable composers in sync on WhatsApp/Telegram/Signal.
+  document.execCommand('selectAll', false);
+  document.execCommand('insertText', false, value);
+  element.dispatchEvent(new InputEvent('input', { bubbles: true, inputType: 'insertText', data: value }));
+}
+
+function dispatchSend(element: HTMLElement): void {
+  for (const type of ['keydown', 'keypress', 'keyup']) {
+    element.dispatchEvent(
+      new KeyboardEvent(type, {
+        key: 'Enter',
+        code: 'Enter',
+        keyCode: 13,
+        which: 13,
+        bubbles: true,
+        cancelable: true,
+      }),
+    );
+  }
+}
+
+async function translateIncoming(element: HTMLElement): Promise<void> {
+  if (!config?.enabled || !config.incomingBilingual || translated.has(element) || translating.has(element)) return;
+  if (element.closest('[data-onechat-translation]')) return;
+  if (isOutgoingMessage(element)) return;
+  const original = (element.innerText || element.textContent || '').trim();
+  if (!original || original.length > 5000) return;
+  translating.add(element);
+  try {
+    const result = await ipcRenderer.invoke('chat-translation:translate', {
+      text: original,
+      direction: 'incoming',
+      sourceLanguage: config.sourceLanguage,
+      targetLanguage: config.incomingTargetLanguage,
+    });
+    if (!element.isConnected || !result?.text || result.text.trim() === original) return;
+    const line = document.createElement('div');
+    line.dataset.onechatTranslation = 'incoming';
+    line.setAttribute('aria-label', '翻译');
+    line.textContent = result.text;
+    line.style.cssText = 'margin-top:4px;padding-top:4px;border-top:1px solid rgba(128,128,128,.22);opacity:.82;font-size:.92em;white-space:pre-wrap;';
+    element.append(line);
+    translated.add(element);
+  } catch (error) {
+    console.warn('[OneChat translation] incoming translation failed', error);
+  } finally {
+    translating.delete(element);
+  }
+}
+
+function scanMessages(root: ParentNode = document): void {
+  const selector = MESSAGE_SELECTORS.join(',');
+  if (root instanceof HTMLElement && root.matches(selector)) void translateIncoming(root);
+  root.querySelectorAll<HTMLElement>(selector).forEach(element => void translateIncoming(element));
+}
+
+async function translateComposer(element: HTMLElement, sendAfter: boolean): Promise<void> {
+  if (element.dataset.onechatTranslating === '1' || !config) return;
+  const source = editableText(element).replace(/\s{3}$/, '').trim();
+  if (!source) return;
+  element.dataset.onechatTranslating = '1';
+  element.setAttribute('aria-busy', 'true');
+  try {
+    const result = await ipcRenderer.invoke('chat-translation:translate', {
+      text: source,
+      direction: 'outgoing',
+      sourceLanguage: config.sourceLanguage,
+      targetLanguage: config.outgoingTargetLanguage,
+    });
+    if (!result?.text) throw new Error('翻译服务未返回译文');
+    replaceEditableText(element, result.text);
+    if (sendAfter) setTimeout(() => dispatchSend(element), 0);
+  } catch (error) {
+    console.warn('[OneChat translation] outgoing translation failed', error);
+  } finally {
+    delete element.dataset.onechatTranslating;
+    element.removeAttribute('aria-busy');
+  }
+}
+
+function findComposer(target: EventTarget | null): HTMLElement | null {
+  const element = target instanceof HTMLElement ? target : null;
+  if (!element) return null;
+  return element.closest<HTMLElement>(COMPOSER_SELECTORS.join(','));
+}
+
+function onKeyDown(event: KeyboardEvent): void {
+  if (!config?.enabled || event.isComposing || event.ctrlKey || event.metaKey || event.altKey) return;
+  const composer = findComposer(event.target);
+  if (!composer) return;
+  if (config.inputMode === 'normal' && event.key === ' ' && /\s{2}$/.test(editableText(composer))) {
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    void translateComposer(composer, false);
+    return;
+  }
+  if (config.inputMode === 'efficiency' && event.key === 'Enter' && !event.shiftKey) {
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    void translateComposer(composer, true);
+  }
+}
+
+export async function initializeChatTranslation(): Promise<void> {
+  try {
+    config = await ipcRenderer.invoke('chat-translation:get-config');
+  } catch (error) {
+    console.warn('[OneChat translation] unable to load configuration', error);
+    return;
+  }
+  document.addEventListener('keydown', onKeyDown, true);
+  const start = () => {
+    scanMessages();
+    observer?.disconnect();
+    observer = new MutationObserver(records => {
+      for (const record of records) {
+        record.addedNodes.forEach(node => {
+          if (node instanceof HTMLElement) scanMessages(node);
+        });
+      }
+    });
+    observer.observe(document.body, { childList: true, subtree: true });
+  };
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true });
+  else start();
+}
