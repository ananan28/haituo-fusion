diff -ruN '--exclude=.github' '--exclude=caisheng.ico' '--exclude=caisheng.png' fusion_base/onechat-main/src/electron/chatTranslation.ts fusion_work/onechat-main/src/electron/chatTranslation.ts
--- fusion_base/onechat-main/src/electron/chatTranslation.ts	1970-01-01 09:00:00.000000000 +0900
+++ fusion_work/onechat-main/src/electron/chatTranslation.ts	2026-09-06 01:24:20.444317131 +0900
@@ -0,0 +1,220 @@
+import { ipcMain } from 'electron';
+import Settings from './Settings';
+
+export type ChatTranslationProvider = 'auto' | 'openai' | 'google' | 'mymemory';
+
+export type ChatTranslationConfig = {
+  enabled: boolean;
+  incomingBilingual: boolean;
+  inputMode: 'normal' | 'efficiency';
+  sourceLanguage: string;
+  incomingTargetLanguage: string;
+  outgoingTargetLanguage: string;
+  provider: ChatTranslationProvider;
+  openAIBaseUrl: string;
+  openAIApiKey: string;
+  openAIModel: string;
+  timeoutMs: number;
+};
+
+export type ChatTranslationRequest = {
+  text: string;
+  targetLanguage?: string;
+  sourceLanguage?: string;
+  direction?: 'incoming' | 'outgoing';
+};
+
+export const DEFAULT_CHAT_TRANSLATION_CONFIG: ChatTranslationConfig = {
+  enabled: true,
+  incomingBilingual: true,
+  inputMode: 'normal',
+  sourceLanguage: 'auto',
+  incomingTargetLanguage: 'zh-CN',
+  outgoingTargetLanguage: 'en',
+  provider: 'auto',
+  openAIBaseUrl: 'https://api.openai.com/v1',
+  openAIApiKey: '',
+  openAIModel: 'gpt-4o-mini',
+  timeoutMs: 20_000,
+};
+
+type Fetch = typeof fetch;
+
+function cleanBaseUrl(url: string): string {
+  return url.trim().replace(/\/+$/, '').replace(/\/chat\/completions$/, '');
+}
+
+function pickOpenAIText(payload: any): string | undefined {
+  const content = payload?.choices?.[0]?.message?.content;
+  if (typeof content === 'string') return content.trim();
+  if (Array.isArray(content)) {
+    const text = content
+      .filter(part => part?.type === 'text' && typeof part.text === 'string')
+      .map(part => part.text)
+      .join('');
+    return text.trim() || undefined;
+  }
+  return undefined;
+}
+
+async function requestJson(
+  url: string,
+  init: RequestInit,
+  timeoutMs: number,
+  fetchImpl: Fetch,
+): Promise<any> {
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), timeoutMs);
+  try {
+    const response = await fetchImpl(url, { ...init, signal: controller.signal });
+    const body = await response.text();
+    let payload: any;
+    try {
+      payload = JSON.parse(body);
+    } catch {
+      payload = body;
+    }
+    if (!response.ok) {
+      throw new Error(
+        payload?.error?.message || payload?.message || body || `${response.status} ${response.statusText}`,
+      );
+    }
+    return payload;
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+async function translateOpenAI(
+  text: string,
+  source: string,
+  target: string,
+  config: ChatTranslationConfig,
+  fetchImpl: Fetch,
+): Promise<string> {
+  if (!config.openAIApiKey.trim()) throw new Error('OpenAI compatible API key is not configured');
+  const payload = await requestJson(
+    `${cleanBaseUrl(config.openAIBaseUrl)}/chat/completions`,
+    {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        Authorization: `Bearer ${config.openAIApiKey.trim()}`,
+      },
+      body: JSON.stringify({
+        model: config.openAIModel,
+        temperature: 0.1,
+        messages: [
+          {
+            role: 'system',
+            content: `You are an expert translator. Translate from ${source} to ${target}. Return only the translation, preserving line breaks, emoji, names and URLs.`,
+          },
+          { role: 'user', content: text },
+        ],
+      }),
+    },
+    config.timeoutMs,
+    fetchImpl,
+  );
+  const translated = pickOpenAIText(payload);
+  if (!translated) throw new Error('OpenAI compatible API returned no translation');
+  return translated;
+}
+
+async function translateGoogle(
+  text: string,
+  source: string,
+  target: string,
+  config: ChatTranslationConfig,
+  fetchImpl: Fetch,
+): Promise<string> {
+  const query = new URLSearchParams({ client: 'gtx', sl: source, tl: target, dt: 't', q: text });
+  const payload = await requestJson(
+    `https://translate.googleapis.com/translate_a/single?${query}`,
+    { method: 'GET' },
+    config.timeoutMs,
+    fetchImpl,
+  );
+  const translated = Array.isArray(payload?.[0])
+    ? payload[0].map((part: any[]) => part?.[0] || '').join('').trim()
+    : '';
+  if (!translated) throw new Error('Google returned no translation');
+  return translated;
+}
+
+async function translateMyMemory(
+  text: string,
+  source: string,
+  target: string,
+  config: ChatTranslationConfig,
+  fetchImpl: Fetch,
+): Promise<string> {
+  // MyMemory requires a concrete source language. "Autodetect" is its supported auto value.
+  const query = new URLSearchParams({ q: text, langpair: `${source === 'auto' ? 'Autodetect' : source}|${target}` });
+  const payload = await requestJson(
+    `https://api.mymemory.translated.net/get?${query}`,
+    { method: 'GET' },
+    config.timeoutMs,
+    fetchImpl,
+  );
+  const translated = payload?.responseData?.translatedText;
+  if (typeof translated !== 'string' || !translated.trim()) {
+    throw new Error(payload?.responseDetails || 'MyMemory returned no translation');
+  }
+  return translated.trim();
+}
+
+export async function translateChatText(
+  request: ChatTranslationRequest,
+  config: ChatTranslationConfig,
+  fetchImpl: Fetch = fetch,
+): Promise<{ text: string; provider: Exclude<ChatTranslationProvider, 'auto'> }> {
+  const text = request.text?.trim();
+  if (!text) throw new Error('请输入需要翻译的文字');
+  if (text.length > 10_000) throw new Error('单次翻译不能超过 10000 个字符');
+  const source = request.sourceLanguage || config.sourceLanguage || 'auto';
+  const target =
+    request.targetLanguage ||
+    (request.direction === 'outgoing'
+      ? config.outgoingTargetLanguage
+      : config.incomingTargetLanguage);
+  const providers: Array<Exclude<ChatTranslationProvider, 'auto'>> =
+    config.provider === 'auto'
+      ? config.openAIApiKey.trim()
+        ? ['openai', 'google', 'mymemory']
+        : ['google', 'mymemory']
+      : [config.provider];
+  const errors: string[] = [];
+  for (const provider of providers) {
+    try {
+      const result =
+        provider === 'openai'
+          ? await translateOpenAI(text, source, target, config, fetchImpl)
+          : provider === 'google'
+            ? await translateGoogle(text, source, target, config, fetchImpl)
+            : await translateMyMemory(text, source, target, config, fetchImpl);
+      return { text: result, provider };
+    } catch (error) {
+      errors.push(`${provider}: ${error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+  throw new Error(`翻译失败（${errors.join('; ')}）`);
+}
+
+export default function registerChatTranslation(): void {
+  const store = new Settings('chat-translation', DEFAULT_CHAT_TRANSLATION_CONFIG);
+  ipcMain.handle('chat-translation:get-config', () => {
+    const config = store.allSerialized as ChatTranslationConfig;
+    return { ...config, openAIApiKey: config.openAIApiKey ? '********' : '' };
+  });
+  ipcMain.handle('chat-translation:set-config', (_event, patch: Partial<ChatTranslationConfig>) => {
+    const safePatch = { ...patch };
+    if (safePatch.openAIApiKey === '********') delete safePatch.openAIApiKey;
+    store.set(safePatch);
+    const config = store.allSerialized as ChatTranslationConfig;
+    return { ...config, openAIApiKey: config.openAIApiKey ? '********' : '' };
+  });
+  ipcMain.handle('chat-translation:translate', (_event, request: ChatTranslationRequest) =>
+    translateChatText(request, store.allSerialized as ChatTranslationConfig),
+  );
+}
