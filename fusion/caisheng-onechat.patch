diff -ruN '--exclude=.github' '--exclude=caisheng.ico' '--exclude=caisheng.png' fusion_base/onechat-main/src/features/signal-managed/manager.ts fusion_work/onechat-main/src/features/signal-managed/manager.ts
--- fusion_base/onechat-main/src/features/signal-managed/manager.ts	1970-01-01 09:00:00.000000000 +0900
+++ fusion_work/onechat-main/src/features/signal-managed/manager.ts	2026-09-06 01:25:25.978176807 +0900
@@ -0,0 +1,185 @@
+import { spawn, type ChildProcess } from 'node:child_process';
+import { randomUUID } from 'node:crypto';
+import { EventEmitter } from 'node:events';
+import { SignalProfileStore } from './profile-store';
+import { signalDaemonArgs, signalRuntimeCommand } from './runtime';
+import type { SignalStatus } from './types';
+
+type ManagedProcess = {
+  child: ChildProcess;
+  status: SignalStatus;
+  abort: AbortController;
+};
+
+const RPC_METHODS = new Set(['listAccounts', 'listContacts', 'listGroups', 'send', 'sendSyncRequest']);
+
+export class ManagedSignalService extends EventEmitter {
+  private readonly processes = new Map<string, ManagedProcess>();
+
+  constructor(private readonly profiles: SignalProfileStore) {
+    super();
+    this.setMaxListeners(100);
+  }
+
+  status(sessionId: string): SignalStatus {
+    return this.processes.get(sessionId)?.status ?? { sessionId, phase: 'idle' };
+  }
+
+  async start(sessionId: string): Promise<SignalStatus> {
+    const active = this.processes.get(sessionId);
+    if (active && active.child.exitCode === null) return active.status;
+    const profile = this.profiles.require(sessionId);
+    if (!profile.enabled) throw new Error('SIGNAL_SESSION_DISABLED');
+    const runtime = signalRuntimeCommand(profile);
+    const abort = new AbortController();
+    const child = spawn(runtime.executable, [...runtime.args, ...signalDaemonArgs(profile)], {
+      cwd: runtime.cwd,
+      windowsHide: true,
+      shell: false,
+      stdio: ['ignore', 'pipe', 'pipe'],
+    });
+    child.stdout?.resume();
+    child.stderr?.resume();
+    const process: ManagedProcess = { child, abort, status: { sessionId, phase: 'starting' } };
+    this.processes.set(sessionId, process);
+    this.setStatus(process, { sessionId, phase: 'starting', message: '正在启动 Signal 服务…' });
+    child.once('exit', () => {
+      abort.abort();
+      if (this.processes.get(sessionId) === process) {
+        this.processes.delete(sessionId);
+        this.emit('status', { sessionId, phase: 'stopped' } satisfies SignalStatus);
+      }
+    });
+    try {
+      await this.waitUntilReady(profile.port, child, abort.signal);
+      const accounts = this.accountList(await this.requestRaw(profile.port, 'listAccounts', {}, abort.signal));
+      if (accounts.length > 1) throw new Error('SIGNAL_PROFILE_HAS_MULTIPLE_ACCOUNTS');
+      if (accounts.length === 1) {
+        if (profile.account && profile.account !== accounts[0]) throw new Error('SIGNAL_ACCOUNT_MISMATCH');
+        this.profiles.update(sessionId, { account: accounts[0] });
+        this.setStatus(process, { sessionId, phase: 'ready', account: accounts[0] });
+        void this.readEvents(sessionId, profile.port, abort.signal);
+        return process.status;
+      }
+      const link = await this.requestRaw(profile.port, 'startLink', {}, abort.signal);
+      if (typeof link?.deviceLinkUri !== 'string' || !link.deviceLinkUri.startsWith('sgnl://linkdevice?')) {
+        throw new Error('SIGNAL_INVALID_QR');
+      }
+      this.setStatus(process, { sessionId, phase: 'pairing', qrUri: link.deviceLinkUri, message: '请用手机 Signal 扫码连接' });
+      void this.finishPairing(sessionId, link.deviceLinkUri, process);
+      return process.status;
+    } catch (error) {
+      await this.stop(sessionId);
+      throw error;
+    }
+  }
+
+  async stop(sessionId: string): Promise<void> {
+    const process = this.processes.get(sessionId);
+    if (!process) return;
+    this.processes.delete(sessionId);
+    process.abort.abort();
+    await new Promise<void>((resolve) => {
+      if (process.child.exitCode !== null) return resolve();
+      const timer = setTimeout(() => { process.child.kill('SIGKILL'); resolve(); }, 2500);
+      process.child.once('exit', () => { clearTimeout(timer); resolve(); });
+      process.child.kill('SIGTERM');
+    });
+    this.emit('status', { sessionId, phase: 'stopped' } satisfies SignalStatus);
+  }
+
+  async stopAll(): Promise<void> {
+    await Promise.all([...this.processes.keys()].map((id) => this.stop(id)));
+  }
+
+  async rpc(sessionId: string, method: string, params: Record<string, unknown> = {}): Promise<any> {
+    if (!RPC_METHODS.has(method)) throw new Error('SIGNAL_RPC_NOT_ALLOWED');
+    const profile = this.profiles.require(sessionId);
+    const process = this.processes.get(sessionId);
+    if (!process || process.status.phase !== 'ready') throw new Error('SIGNAL_NOT_READY');
+    return this.requestRaw(profile.port, method, { ...params, account: profile.account }, process.abort.signal);
+  }
+
+  private async finishPairing(sessionId: string, uri: string, process: ManagedProcess) {
+    try {
+      const profile = this.profiles.require(sessionId);
+      await this.requestRaw(profile.port, 'finishLink', { deviceLinkUri: uri, deviceName: `OneChat ${profile.name}` }, process.abort.signal, 180_000);
+      const accounts = this.accountList(await this.requestRaw(profile.port, 'listAccounts', {}, process.abort.signal));
+      if (accounts.length !== 1) throw new Error('SIGNAL_PAIRING_ACCOUNT_COUNT');
+      if (profile.account && profile.account !== accounts[0]) throw new Error('SIGNAL_ACCOUNT_MISMATCH');
+      this.profiles.update(sessionId, { account: accounts[0] });
+      this.setStatus(process, { sessionId, phase: 'ready', account: accounts[0] });
+      void this.readEvents(sessionId, profile.port, process.abort.signal);
+    } catch (error) {
+      if (!process.abort.signal.aborted) this.setStatus(process, { sessionId, phase: 'error', code: (error as Error).message });
+    }
+  }
+
+  private async readEvents(sessionId: string, port: number, signal: AbortSignal) {
+    try {
+      const response = await fetch(`http://127.0.0.1:${port}/api/v1/events`, { headers: { Accept: 'text/event-stream' }, signal });
+      if (!response.ok || !response.body) throw new Error('SIGNAL_EVENT_STREAM');
+      const reader = response.body.getReader();
+      const decoder = new TextDecoder();
+      let buffer = '';
+      while (!signal.aborted) {
+        const chunk = await reader.read();
+        if (chunk.done) break;
+        buffer += decoder.decode(chunk.value, { stream: true });
+        const frames = buffer.split(/\r?\n\r?\n/);
+        buffer = frames.pop() ?? '';
+        for (const frame of frames) {
+          const raw = frame.split(/\r?\n/).filter((line) => line.startsWith('data:')).map((line) => line.slice(5).trimStart()).join('\n');
+          if (!raw) continue;
+          try { this.emit('event', { sessionId, payload: JSON.parse(raw) }); } catch { /* malformed event */ }
+        }
+      }
+    } catch (error) {
+      if (!signal.aborted) this.emit('service-error', { sessionId, error });
+    }
+  }
+
+  private setStatus(process: ManagedProcess, status: SignalStatus) {
+    process.status = status;
+    this.emit('status', status);
+  }
+
+  private accountList(raw: any): string[] {
+    const values = Array.isArray(raw) ? raw : raw?.accounts ?? [];
+    return values.map((value: any) => typeof value === 'string' ? value : value?.number ?? value?.account ?? '').filter(Boolean);
+  }
+
+  private async waitUntilReady(port: number, child: ChildProcess, signal: AbortSignal) {
+    const deadline = Date.now() + 45_000;
+    while (Date.now() < deadline && !signal.aborted) {
+      if (child.exitCode !== null || child.signalCode !== null) throw new Error('SIGNAL_CORE_EXIT');
+      try {
+        const response = await fetch(`http://127.0.0.1:${port}/api/v1/check`, { signal: AbortSignal.timeout(800) });
+        if (response.ok) return;
+      } catch { /* keep polling */ }
+      await new Promise((resolve) => setTimeout(resolve, 250));
+    }
+    throw new Error('SIGNAL_START_TIMEOUT');
+  }
+
+  private async requestRaw(port: number, method: string, params: Record<string, unknown>, signal: AbortSignal, timeout = 30_000): Promise<any> {
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), timeout);
+    const abort = () => controller.abort();
+    signal.addEventListener('abort', abort, { once: true });
+    try {
+      const response = await fetch(`http://127.0.0.1:${port}/api/v1/rpc`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        signal: controller.signal,
+        body: JSON.stringify({ jsonrpc: '2.0', id: randomUUID(), method, params }),
+      });
+      const data = await response.json();
+      if (!response.ok || (data as any).error) throw new Error((data as any).error?.message ?? `SIGNAL_HTTP_${response.status}`);
+      return (data as any).result;
+    } finally {
+      clearTimeout(timer);
+      signal.removeEventListener('abort', abort);
+    }
+  }
+}
diff -ruN '--exclude=.github' '--exclude=caisheng.ico' '--exclude=caisheng.png' fusion_base/onechat-main/src/features/signal-managed/profile-store.ts fusion_work/onechat-main/src/features/signal-managed/profile-store.ts
--- fusion_base/onechat-main/src/features/signal-managed/profile-store.ts	1970-01-01 09:00:00.000000000 +0900
+++ fusion_work/onechat-main/src/features/signal-managed/profile-store.ts	2026-09-06 01:26:27.931932786 +0900
@@ -0,0 +1,106 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import type { SignalSessionProfile } from './types';
+
+const SESSION_ID = /^[a-zA-Z0-9_-]{1,64}$/;
+const FIRST_PORT = 7503;
+
+export class SignalProfileStore {
+  private readonly file: string;
+
+  constructor(private readonly userDataDir: string) {
+    this.file = path.join(userDataDir, 'signal-managed', 'profiles.json');
+  }
+
+  list(): SignalSessionProfile[] {
+    return Object.values(this.read()).sort((a, b) => a.createdAt - b.createdAt);
+  }
+
+  get(id: string): SignalSessionProfile | undefined {
+    this.assertId(id);
+    return this.read()[id];
+  }
+
+  create(id: string, name = 'Signal'): SignalSessionProfile {
+    this.assertId(id);
+    const profiles = this.read();
+    if (profiles[id]) throw new Error('SIGNAL_SESSION_EXISTS');
+    const ports = new Set(Object.values(profiles).map((profile) => profile.port));
+    let port = FIRST_PORT;
+    while (ports.has(port) && port < 65_535) port += 1;
+    if (port > 65_535) throw new Error('SIGNAL_NO_PORT');
+    const root = path.join(this.userDataDir, 'signal-managed', 'sessions', id);
+    const profile: SignalSessionProfile = {
+      id,
+      name: name.trim() || 'Signal',
+      account: '',
+      port,
+      dataDir: path.join(root, 'data'),
+      runtimeDir: path.join(root, 'runtime'),
+      enabled: true,
+      createdAt: Date.now(),
+    };
+    this.prepareDirectories(profile);
+    profiles[id] = profile;
+    this.write(profiles);
+    return profile;
+  }
+
+  require(id: string): SignalSessionProfile {
+    const profile = this.get(id);
+    if (!profile) throw new Error('SIGNAL_SESSION_NOT_FOUND');
+    this.prepareDirectories(profile);
+    return profile;
+  }
+
+  update(
+    id: string,
+    patch: Partial<Pick<SignalSessionProfile, 'name' | 'account' | 'port' | 'enabled'>>,
+  ): SignalSessionProfile {
+    const profiles = this.read();
+    const current = profiles[id];
+    if (!current) throw new Error('SIGNAL_SESSION_NOT_FOUND');
+    if (patch.port !== undefined && (!Number.isInteger(patch.port) || patch.port < 1024 || patch.port > 65_535)) {
+      throw new Error('SIGNAL_INVALID_PORT');
+    }
+    if (patch.port !== undefined && Object.values(profiles).some((item) => item.id !== id && item.port === patch.port)) {
+      throw new Error('SIGNAL_PORT_IN_USE');
+    }
+    profiles[id] = { ...current, ...patch, id: current.id, dataDir: current.dataDir, runtimeDir: current.runtimeDir };
+    this.write(profiles);
+    return profiles[id];
+  }
+
+  remove(id: string): void {
+    this.assertId(id);
+    const profiles = this.read();
+    if (!profiles[id]) return;
+    delete profiles[id];
+    this.write(profiles);
+  }
+
+  private assertId(id: string) {
+    if (!SESSION_ID.test(id)) throw new Error('SIGNAL_INVALID_SESSION_ID');
+  }
+
+  private prepareDirectories(profile: SignalSessionProfile) {
+    fs.mkdirSync(profile.dataDir, { recursive: true, mode: 0o700 });
+    fs.mkdirSync(profile.runtimeDir, { recursive: true, mode: 0o700 });
+  }
+
+  private read(): Record<string, SignalSessionProfile> {
+    try {
+      const parsed = JSON.parse(fs.readFileSync(this.file, 'utf8'));
+      return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
+    } catch {
+      return {};
+    }
+  }
+
+  private write(profiles: Record<string, SignalSessionProfile>) {
+    fs.mkdirSync(path.dirname(this.file), { recursive: true, mode: 0o700 });
+    const temporary = `${this.file}.tmp`;
+    fs.writeFileSync(temporary, JSON.stringify(profiles, null, 2), { mode: 0o600 });
+    fs.renameSync(temporary, this.file);
+  }
+}
diff -ruN '--exclude=.github' '--exclude=caisheng.ico' '--exclude=caisheng.png' fusion_base/onechat-main/src/features/signal-managed/runtime.ts fusion_work/onechat-main/src/features/signal-managed/runtime.ts
--- fusion_base/onechat-main/src/features/signal-managed/runtime.ts	1970-01-01 09:00:00.000000000 +0900
+++ fusion_work/onechat-main/src/features/signal-managed/runtime.ts	2026-09-06 01:25:00.777461826 +0900
@@ -0,0 +1,43 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import type { SignalSessionProfile } from './types';
+
+export type SignalRuntimeCommand = { executable: string; args: string[]; cwd: string };
+
+export function provisionSignalRuntime(templateDir: string, profile: SignalSessionProfile): void {
+  const manifest = path.join(templateDir, 'runtime-manifest.json');
+  const javaDir = path.join(templateDir, 'jre');
+  const signalCliDir = path.join(templateDir, 'signal-cli');
+  if (!fs.existsSync(manifest) || !fs.existsSync(javaDir) || !fs.existsSync(signalCliDir)) {
+    throw new Error('SIGNAL_RUNTIME_TEMPLATE_INVALID');
+  }
+  fs.mkdirSync(profile.runtimeDir, { recursive: true, mode: 0o700 });
+  fs.cpSync(javaDir, path.join(profile.runtimeDir, 'jre'), { recursive: true, force: false, errorOnExist: false });
+  fs.cpSync(signalCliDir, path.join(profile.runtimeDir, 'signal-cli'), { recursive: true, force: false, errorOnExist: false });
+  fs.copyFileSync(manifest, path.join(profile.runtimeDir, 'runtime-manifest.json'));
+}
+
+export function signalRuntimeCommand(profile: SignalSessionProfile): SignalRuntimeCommand {
+  const executable = path.join(profile.runtimeDir, 'jre', 'bin', process.platform === 'win32' ? 'java.exe' : 'java');
+  const lib = path.join(profile.runtimeDir, 'signal-cli', 'lib');
+  const manifest = path.join(profile.runtimeDir, 'runtime-manifest.json');
+  if (!fs.existsSync(executable) || !fs.existsSync(lib) || !fs.existsSync(manifest)) {
+    throw new Error('SIGNAL_RUNTIME_MISSING');
+  }
+  return {
+    executable,
+    cwd: profile.runtimeDir,
+    args: [
+      '--enable-native-access=ALL-UNNAMED',
+      '-Xms32m',
+      '-Xmx256m',
+      '-cp',
+      path.join(lib, '*'),
+      'org.asamk.signal.Main',
+    ],
+  };
+}
+
+export function signalDaemonArgs(profile: SignalSessionProfile): string[] {
+  return ['--config', profile.dataDir, '--scrub-log', 'daemon', '--http', `127.0.0.1:${profile.port}`];
+}
