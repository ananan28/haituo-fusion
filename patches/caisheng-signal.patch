@@ -0,0 +1,84 @@
+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+/**
+ * Platform capabilities live here instead of in the shell. Adding a platform
+ * therefore does not require another branch in the UI or Electron main process.
+ */
+export type CaishengPlatformId = 'signal' | 'whatsapp' | 'telegram';
+
+export type CaishengPlatformAdapter = Readonly<{
+  id: CaishengPlatformId;
+  label: string;
+  runtime: 'native' | 'web';
+  startUrl?: string;
+  allowedHosts: ReadonlyArray<string>;
+  defaultIcon: string;
+}>;
+
+const REGISTRY: Readonly<Record<CaishengPlatformId, CaishengPlatformAdapter>> =
+  Object.freeze({
+    signal: {
+      id: 'signal',
+      label: 'Signal',
+      runtime: 'native',
+      allowedHosts: [],
+      defaultIcon: 'signal',
+    },
+    whatsapp: {
+      id: 'whatsapp',
+      label: 'WhatsApp',
+      runtime: 'web',
+      startUrl: 'https://web.whatsapp.com/',
+      allowedHosts: ['web.whatsapp.com'],
+      defaultIcon: 'whatsapp',
+    },
+    telegram: {
+      id: 'telegram',
+      label: 'Telegram',
+      runtime: 'web',
+      startUrl: 'https://web.telegram.org/k/',
+      allowedHosts: ['web.telegram.org'],
+      defaultIcon: 'telegram',
+    },
+  });
+
+export const CAISHENG_PLATFORM_IDS = Object.freeze(
+  Object.keys(REGISTRY) as Array<CaishengPlatformId>
+);
+
+export function getCaishengPlatformAdapter(
+  id: CaishengPlatformId
+): CaishengPlatformAdapter {
+  return REGISTRY[id];
+}
+
+export function getCaishengPlatformAdapters(): ReadonlyArray<CaishengPlatformAdapter> {
+  return CAISHENG_PLATFORM_IDS.map(id => REGISTRY[id]);
+}
+
+export function isCaishengPlatformId(
+  value: string
+): value is CaishengPlatformId {
+  return Object.hasOwn(REGISTRY, value);
+}
+
+export function isAllowedCaishengPlatformUrl(
+  platformId: CaishengPlatformId,
+  value: string
+): boolean {
+  const adapter = getCaishengPlatformAdapter(platformId);
+  if (adapter.runtime !== 'web') {
+    return false;
+  }
+
+  try {
+    const url = new URL(value);
+    return (
+      url.protocol === 'https:' && adapter.allowedHosts.includes(url.hostname)
+    );
+  } catch {
+    return false;
+  }
+}
+
diff -ruN '--exclude=node_modules' '--exclude=.git' '--exclude=release' a/ts/services/caishengTranslation.dom.ts b/ts/services/caishengTranslation.dom.ts
--- a/ts/services/caishengTranslation.dom.ts	1969-12-31 18:00:00.000000000 -0600
+++ b/ts/services/caishengTranslation.dom.ts	2026-09-05 00:20:05.690531583 -0500
@@ -0,0 +1,70 @@
+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+export type CaishengTranslationProvider = 'auto' | 'google-free' | 'mymemory' | 'libre' | 'microsoft' | 'openai' | 'qwen' | 'glm';
+export type CaishengTranslationSettings = Readonly<{
+  provider: CaishengTranslationProvider; apiKey: string; targetLanguage: string;
+  openAIModel: string; autoTranslateIncoming: boolean; libreEndpoint: string;
+  microsoftRegion: string; compatibleEndpoint: string; timeoutMs: number;
+  efficiencyMode?: boolean;
+}>;
+
+const SETTINGS_KEY = 'caisheng.translation.settings.v1';
+const CACHE_LIMIT = 300;
+const translationCache = new Map<string, string>();
+const DEFAULT_SETTINGS: CaishengTranslationSettings = {
+  provider: 'auto', apiKey: '', targetLanguage: 'zh-CN', openAIModel: 'gpt-4.1-mini',
+  autoTranslateIncoming: true, libreEndpoint: '', microsoftRegion: '', compatibleEndpoint: '', timeoutMs: 10000,
+  efficiencyMode: false,
+};
+
+export function getCaishengTargetLanguage(text: string): 'en' | 'zh-CN' {
+  return /[\u3400-\u9fff]/u.test(text) ? 'en' : 'zh-CN';
+}
+export function loadCaishengTranslationSettings(): CaishengTranslationSettings {
+  try {
+    const saved = JSON.parse(localStorage.getItem(SETTINGS_KEY) ?? '{}');
+    if (saved.provider === 'google') saved.provider = 'auto';
+    return { ...DEFAULT_SETTINGS, ...saved };
+  } catch { return DEFAULT_SETTINGS; }
+}
+export function saveCaishengTranslationSettings(settings: CaishengTranslationSettings): void {
+  localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
+}
+export function getCaishengProviderOrder(settings: CaishengTranslationSettings): ReadonlyArray<CaishengTranslationProvider> {
+  if (settings.provider !== 'auto') return [settings.provider];
+  const configuredAI = settings.apiKey?.trim()
+    ? (settings.compatibleEndpoint?.trim() ? ['qwen'] as const : ['openai'] as const)
+    : [];
+  return settings.libreEndpoint?.trim()
+    ? [...configuredAI, 'google-free', 'mymemory', 'libre']
+    : [...configuredAI, 'google-free', 'mymemory'];
+}
+async function withProvider(text: string, settings: CaishengTranslationSettings, provider: CaishengTranslationProvider): Promise<string> {
+  const result = await window.SignalContext.caishengTranslate({
+    text, targetLanguage: settings.targetLanguage, provider,
+    apiKey: settings.apiKey,
+    endpoint:
+      provider === 'libre'
+        ? settings.libreEndpoint
+        : settings.compatibleEndpoint,
+    model: settings.openAIModel, region: settings.microsoftRegion, timeoutMs: settings.timeoutMs,
+  });
+  return result.text.trim();
+}
+export async function translateCaishengText(text: string, settings: CaishengTranslationSettings): Promise<string> {
+  if (!text.trim()) throw new Error('请输入要翻译的内容');
+  const key = `${settings.provider}\u0000${settings.openAIModel}\u0000${settings.compatibleEndpoint}\u0000${settings.targetLanguage}\u0000${text}`;
+  const cached = translationCache.get(key); if (cached) return cached;
+  const errors: string[] = [];
+  for (const provider of getCaishengProviderOrder(settings)) {
+    try {
+      const output = await withProvider(text, settings, provider);
+      if (!output) throw new Error('返回内容为空');
+      translationCache.set(key, output);
+      if (translationCache.size > CACHE_LIMIT) translationCache.delete(translationCache.keys().next().value as string);
+      return output;
+    } catch (reason) { errors.push(reason instanceof Error ? reason.message : String(reason)); }
+  }
+  throw new Error(errors.join('；'));
+}
diff -ruN '--exclude=node_modules' '--exclude=.git' '--exclude=release' a/ts/services/caishengWorkspace.std.ts b/ts/services/caishengWorkspace.std.ts
