diff -ruN '--exclude=node_modules' '--exclude=.git' a/ts/components/CaishengAuthGate.dom.tsx b/ts/components/CaishengAuthGate.dom.tsx
--- a/ts/components/CaishengAuthGate.dom.tsx	1969-12-31 18:00:00.000000000 -0600
+++ b/ts/components/CaishengAuthGate.dom.tsx	2026-09-04 20:52:15.321802775 -0500
@@ -0,0 +1,134 @@
+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import {
+  createContext,
+  useContext,
+  useMemo,
+  useState,
+  type FormEvent,
+  type JSX,
+  type ReactNode,
+} from 'react';
+import {
+  loginToCaisheng,
+  type CaishengLoginResult,
+} from '../services/caishengAuth.dom.ts';
+
+const CaishengAuthContext = createContext<CaishengLoginResult | null>(null);
+
+export function useCaishengAuth(): CaishengLoginResult {
+  const value = useContext(CaishengAuthContext);
+  if (!value) {
+    throw new Error('Caisheng authentication is not ready');
+  }
+  return value;
+}
+
+export function CaishengAuthGate({
+  children,
+}: Readonly<{ children: ReactNode }>): JSX.Element {
+  const [login, setLogin] = useState<CaishengLoginResult | null>(null);
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [proxyUrl, setProxyUrl] = useState('');
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState(false);
+
+  const context = useMemo(() => login, [login]);
+
+  async function submit(event: FormEvent<HTMLFormElement>): Promise<void> {
+    event.preventDefault();
+    if (!username.trim()) {
+      setError('请输入中文账号');
+      return;
+    }
+    if (!/^\d{6}$/.test(password)) {
+      setError('密码必须是六位数字');
+      return;
+    }
+
+    setBusy(true);
+    setError('');
+    try {
+      setLogin(await loginToCaisheng(username, password, proxyUrl.trim() || undefined));
+    } catch (reason) {
+      const message = reason instanceof Error ? reason.message : '登录失败';
+      setError(
+        message === 'Failed to fetch'
+          ? '无法连接登录服务器，请检查网络后重试'
+          : message
+      );
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  if (context) {
+    if (!context.user.signalEnabled) {
+      return (
+        <main className="CaishengLogin">
+          <section className="CaishengLogin__box">
+            <div className="CaishengLogin__brand">财盛</div>
+            <h1>Signal 未授权</h1>
+            <p>当前账号没有使用 Signal 的权限，请联系管理员开启。</p>
+            <button type="button" onClick={() => setLogin(null)}>
+              返回登录
+            </button>
+          </section>
+        </main>
+      );
+    }
+    return (
+      <CaishengAuthContext.Provider value={context}>
+        {children}
+      </CaishengAuthContext.Provider>
+    );
+  }
+
+  return (
+    <main className="CaishengLogin">
+      <form className="CaishengLogin__box" onSubmit={submit}>
+        <div className="CaishengLogin__brand">财盛</div>
+        <h1>财盛技术部内供翻译</h1>
+        <p>企业多账号翻译工作台</p>
+        <label>
+          中文账号
+          <input
+            autoFocus
+            autoComplete="username"
+            value={username}
+            onChange={event => setUsername(event.target.value)}
+          />
+        </label>
+        <label>
+          六位密码
+          <input
+            autoComplete="current-password"
+            inputMode="numeric"
+            maxLength={6}
+            type="password"
+            value={password}
+            onChange={event =>
+              setPassword(event.target.value.replace(/\D/g, '').slice(0, 6))
+            }
+          />
+        </label>
+        <label>
+          代理地址（无法连接时填写）
+          <input
+            autoComplete="off"
+            placeholder="例如 http://127.0.0.1:7890"
+            value={proxyUrl}
+            onChange={event => setProxyUrl(event.target.value)}
+          />
+        </label>
+        {error ? <div className="CaishengLogin__error">{error}</div> : null}
+        <button disabled={busy} type="submit">
+          {busy ? '正在登录…' : '安全登录'}
+        </button>
+        <small>登录只使用财盛内部账号，不接收 Supabase 管理密码</small>
+      </form>
+    </main>
+  );
+}
diff -ruN '--exclude=node_modules' '--exclude=.git' a/ts/components/CaishengComposerTranslator.dom.tsx b/ts/components/CaishengComposerTranslator.dom.tsx
--- a/ts/components/CaishengComposerTranslator.dom.tsx	1969-12-31 18:00:00.000000000 -0600
+++ b/ts/components/CaishengComposerTranslator.dom.tsx	2026-09-04 20:13:13.234848933 -0500
@@ -0,0 +1,158 @@
+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import { useCallback, useState, type JSX } from 'react';
+import {
+  loadCaishengTranslationSettings,
+  saveCaishengTranslationSettings,
+  translateCaishengText,
+  type CaishengTranslationProvider,
+} from '../services/caishengTranslation.dom.ts';
+
+export type CaishengComposerTranslatorProps = Readonly<{
+  disabled: boolean;
+  text: string;
+  onApplyTranslation: (translatedText: string) => void;
+  onSendTranslation: (translatedText: string) => void;
+}>;
+
+export function CaishengComposerTranslator({
+  disabled,
+  text,
+  onApplyTranslation,
+  onSendTranslation,
+}: CaishengComposerTranslatorProps): JSX.Element {
+  const [settings, setSettings] = useState(loadCaishengTranslationSettings);
+  const [showSettings, setShowSettings] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+
+  const update = useCallback(
+    (next: Partial<typeof settings>) => {
+      const value = { ...settings, ...next };
+      setSettings(value);
+      saveCaishengTranslationSettings(value);
+    },
+    [settings]
+  );
+
+  const run = useCallback(
+    async (send: boolean) => {
+      setBusy(true);
+      setError('');
+      try {
+        const translated = await translateCaishengText(text, settings);
+        if (send) {
+          onSendTranslation(translated);
+        } else {
+          onApplyTranslation(translated);
+        }
+      } catch (reason) {
+        setError(reason instanceof Error ? reason.message : '翻译失败');
+      } finally {
+        setBusy(false);
+      }
+    },
+    [onApplyTranslation, onSendTranslation, settings, text]
+  );
+
+  return (
+    <div className="CaishengComposerTranslator">
+      <div className="CaishengComposerTranslator__toolbar">
+        <strong>财盛翻译</strong>
+        <select
+          aria-label="目标语言"
+          value={settings.targetLanguage}
+          onChange={event => update({ targetLanguage: event.target.value })}
+        >
+          <option value="zh-CN">中文</option>
+          <option value="en">English</option>
+          <option value="ja">日本語</option>
+          <option value="ko">한국어</option>
+          <option value="es">Español</option>
+        </select>
+        <button type="button" onClick={() => setShowSettings(value => !value)}>
+          API 设置
+        </button>
+        <button
+          type="button"
+          disabled={disabled || busy}
+          onClick={() => void run(false)}
+        >
+          {busy ? '翻译中…' : '翻译'}
+        </button>
+        <button
+          type="button"
+          disabled={disabled || busy}
+          onClick={() => void run(true)}
+        >
+          翻译后发送
+        </button>
+      </div>
+      {showSettings ? (
+        <div className="CaishengComposerTranslator__settings">
+          <select
+            aria-label="翻译服务"
+            value={settings.provider}
+            onChange={event =>
+              update({
+                provider: event.target.value as CaishengTranslationProvider,
+              })
+            }
+          >
+            <option value="auto">自动选择（免费优先）</option>
+            <option value="google-free">Google 免费公共翻译</option>
+            <option value="mymemory">MyMemory 免费翻译</option>
+            <option value="libre">LibreTranslate</option>
+            <option value="microsoft">微软翻译（需配置）</option>
+            <option value="openai">OpenAI（需配置）</option>
+            <option value="qwen">Qwen3-8B（需配置）</option>
+            <option value="glm">GLM-4-9B（需配置）</option>
+          </select>
+          <input
+            aria-label="翻译 API Key"
+            type="password"
+            value={settings.apiKey}
+            placeholder="API Key（仅保存在本机）"
+            onChange={event => update({ apiKey: event.target.value })}
+          />
+          {settings.provider === 'openai' ? (
+            <input
+              aria-label="OpenAI 模型"
+              value={settings.openAIModel}
+              onChange={event => update({ openAIModel: event.target.value })}
+            />
+          ) : null}
+          {settings.provider === 'libre' ? (
+            <input aria-label="LibreTranslate 服务地址" value={settings.libreEndpoint}
+              placeholder="https://你的-libretranslate-服务"
+              onChange={event => update({ libreEndpoint: event.target.value })} />
+          ) : null}
+          {settings.provider === 'microsoft' ? (
+            <input aria-label="微软翻译区域" value={settings.microsoftRegion}
+              placeholder="Azure 区域（如 eastasia）"
+              onChange={event => update({ microsoftRegion: event.target.value })} />
+          ) : null}
+          {settings.provider === 'qwen' || settings.provider === 'glm' ? (
+            <input aria-label="OpenAI 兼容 API 地址" value={settings.compatibleEndpoint}
+              placeholder="OpenAI 兼容 API 地址"
+              onChange={event => update({ compatibleEndpoint: event.target.value })} />
+          ) : null}
+          <label>
+            <input
+              checked={settings.autoTranslateIncoming}
+              type="checkbox"
+              onChange={event =>
+                update({ autoTranslateIncoming: event.target.checked })
+              }
+            />
+            自动翻译收到的消息
+          </label>
+        </div>
+      ) : null}
+      {error ? (
+        <div className="CaishengComposerTranslator__error">{error}</div>
+      ) : null}
+    </div>
+  );
+}
