--- a/app/caishengWebviewTranslation.main.ts	1969-12-31 18:00:00.000000000 -0600
+++ b/app/caishengWebviewTranslation.main.ts	2026-09-05 00:16:47.161747312 -0500
@@ -0,0 +1,86 @@
+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import { ipcMain, net } from 'electron';
+
+const ALLOWED_HOSTS = new Set(['web.whatsapp.com', 'web.telegram.org']);
+
+function assertAllowedSender(url: string): void {
+  let hostname = '';
+  try {
+    hostname = new URL(url).hostname;
+  } catch {
+    // Rejected below.
+  }
+  const protocol = (() => { try { return new URL(url).protocol; } catch { return ''; } })();
+  if (protocol !== 'file:' && hostname !== 'localhost' && hostname !== '127.0.0.1' && !ALLOWED_HOSTS.has(hostname)) {
+    throw new Error('不允许的翻译请求来源');
+  }
+}
+
+type TranslationRequest = Readonly<{
+  text?: unknown; targetLanguage?: unknown; provider?: unknown; apiKey?: unknown;
+  endpoint?: unknown; model?: unknown; region?: unknown; timeoutMs?: unknown;
+}>;
+
+async function fetchJson(url: string, init: RequestInit, timeoutMs: number): Promise<any> {
+  const response = await net.fetch(url, { ...init, signal: AbortSignal.timeout(timeoutMs) });
+  if (!response.ok) throw new Error(`HTTP ${response.status}`);
+  return response.json();
+}
+
+async function performTranslation(input: TranslationRequest): Promise<{ text: string; provider: string }> {
+  const text = typeof input.text === 'string' ? input.text.trim() : '';
+  const target = typeof input.targetLanguage === 'string' ? input.targetLanguage : 'zh-CN';
+  const provider = typeof input.provider === 'string' ? input.provider : 'google-free';
+  const timeout = typeof input.timeoutMs === 'number' ? Math.min(Math.max(input.timeoutMs, 1000), 30000) : 12000;
+  if (!text || text.length > 30000) throw new Error('翻译内容为空或过长');
+  let translated = '';
+  if (provider === 'google-free') {
+    const url = new URL('https://translate.googleapis.com/translate_a/single');
+    url.search = new URLSearchParams({ client: 'gtx', sl: 'auto', tl: target, dt: 't', q: text }).toString();
+    const body = await fetchJson(url.href, {}, timeout);
+    translated = (body?.[0] ?? []).map((part: unknown[]) => typeof part?.[0] === 'string' ? part[0] : '').join('').trim();
+  } else if (provider === 'mymemory') {
+    if (!/[\u3400-\u9fff]/u.test(text) && target !== 'zh-CN') throw new Error('MyMemory 仅作为中英翻译备用');
+    const source = /[\u3400-\u9fff]/u.test(text) ? 'zh-CN' : 'en';
+    const url = new URL('https://api.mymemory.translated.net/get');
+    url.searchParams.set('q', text); url.searchParams.set('langpair', `${source}|${target}`);
+    const body = await fetchJson(url.href, {}, timeout);
+    translated = body?.responseData?.translatedText?.trim() ?? '';
+  } else if (provider === 'libre') {
+    const endpoint = typeof input.endpoint === 'string' ? input.endpoint.replace(/\/$/u, '') : '';
+    if (!endpoint) throw new Error('LibreTranslate 未配置服务地址');
+    const body = await fetchJson(`${endpoint}/translate`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ q: text, source: 'auto', target, ...(input.apiKey ? { api_key: input.apiKey } : {}) }) }, timeout);
+    translated = body?.translatedText?.trim() ?? '';
+  } else if (provider === 'microsoft') {
+    if (typeof input.apiKey !== 'string' || !input.apiKey) throw new Error('微软翻译需要 API Key');
+    const url = new URL('https://api.cognitive.microsofttranslator.com/translate');
+    url.searchParams.set('api-version', '3.0'); url.searchParams.set('to', target);
+    const body = await fetchJson(url.href, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Ocp-Apim-Subscription-Key': input.apiKey, ...(input.region ? { 'Ocp-Apim-Subscription-Region': String(input.region) } : {}) }, body: JSON.stringify([{ Text: text }]) }, timeout);
+    translated = body?.[0]?.translations?.[0]?.text?.trim() ?? '';
+  } else if (provider === 'openai' || provider === 'qwen' || provider === 'glm') {
+    if (typeof input.apiKey !== 'string' || !input.apiKey) throw new Error(`${provider} 需要 API Key`);
+    const endpoint = typeof input.endpoint === 'string' && input.endpoint ? input.endpoint.replace(/\/$/u, '') : 'https://api.openai.com/v1';
+    const body = await fetchJson(`${endpoint}/chat/completions`, { method: 'POST', headers: { Authorization: `Bearer ${input.apiKey}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ model: input.model || 'gpt-4.1-mini', temperature: 0, messages: [{ role: 'system', content: 'You are a precise chat translator. Preserve names, numbers, URLs, emojis, line breaks and tone. Return only the translation.' }, { role: 'user', content: `Target language: ${target}\n\n${text}` }] }) }, timeout);
+    translated = body?.choices?.[0]?.message?.content?.trim() ?? '';
+  } else throw new Error('不支持的翻译服务');
+  if (!translated) throw new Error('翻译服务未返回结果');
+  return { text: translated, provider };
+}
+
+export function installCaishengWebviewTranslation(): void {
+  ipcMain.removeHandler('caisheng:translate');
+  ipcMain.handle('caisheng:translate', async (event, request: TranslationRequest) => {
+    assertAllowedSender(event.senderFrame?.url ?? '');
+    return performTranslation(request ?? {});
+  });
+  ipcMain.removeHandler('caisheng:webview-translate');
+  ipcMain.handle(
+    'caisheng:webview-translate',
+    async (event, value: unknown, target: unknown) => {
+      assertAllowedSender(event.senderFrame?.url ?? '');
+      return performTranslation({ text: value, targetLanguage: target, provider: 'google-free' });
+    }
+  );
+}
