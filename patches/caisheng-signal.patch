diff -ruN '--exclude=node_modules' '--exclude=.git' a/js/caisheng-webview-preload.js b/js/caisheng-webview-preload.js
--- a/js/caisheng-webview-preload.js	1969-12-31 18:00:00.000000000 -0600
+++ b/js/caisheng-webview-preload.js	2026-09-04 20:10:46.479103861 -0500
@@ -0,0 +1,133 @@
+'use strict';
+
+const { ipcRenderer } = require('electron');
+
+const busy = new WeakSet();
+const translated = new WeakSet();
+
+function editable(node) {
+  return node instanceof HTMLInputElement || node instanceof HTMLTextAreaElement ||
+    (node instanceof HTMLElement && node.isContentEditable);
+}
+
+function read(node) {
+  return node instanceof HTMLInputElement || node instanceof HTMLTextAreaElement
+    ? node.value : node.innerText;
+}
+
+function write(node, value) {
+  node.focus();
+  if (node instanceof HTMLInputElement || node instanceof HTMLTextAreaElement) {
+    const proto = node instanceof HTMLTextAreaElement ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
+    const setter = Object.getOwnPropertyDescriptor(proto, 'value')?.set;
+    if (setter) setter.call(node, value); else node.value = value;
+  } else {
+    const selection = window.getSelection();
+    const range = document.createRange();
+    range.selectNodeContents(node);
+    selection?.removeAllRanges();
+    selection?.addRange(range);
+    if (!document.execCommand('insertText', false, value)) node.textContent = value;
+  }
+  node.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true, inputType: 'insertText', data: value }));
+  node.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+}
+
+function toast(message, error = false) {
+  document.getElementById('caisheng-translate-toast')?.remove();
+  const node = document.createElement('div');
+  node.id = 'caisheng-translate-toast';
+  node.textContent = message;
+  Object.assign(node.style, { position: 'fixed', right: '20px', bottom: '82px', zIndex: '2147483647', padding: '10px 16px', borderRadius: '8px', color: '#fff', background: error ? '#c63d3d' : '#202a3b', boxShadow: '0 8px 30px #0004', fontSize: '13px' });
+  document.body.append(node);
+  setTimeout(() => node.remove(), 2200);
+}
+
+async function requestTranslation(text) {
+  const target = /[\u3400-\u9fff]/.test(text) ? 'en' : 'zh-CN';
+  const result = await ipcRenderer.invoke('caisheng:webview-translate', text, target);
+  if (!result || typeof result.text !== 'string') throw new Error('翻译服务未返回结果');
+  return result.text;
+}
+
+async function translateComposer(target) {
+  if (busy.has(target)) return;
+  const original = read(target).replace(/ {2}$/, '').trim();
+  if (!original) return;
+  busy.add(target);
+  toast('正在智能翻译…');
+  try {
+    const result = await requestTranslation(original);
+    const current = read(target).replace(/ {2}$/, '').trim();
+    if (current !== original) return toast('输入内容已变化，本次译文未覆盖');
+    write(target, result);
+    toast('翻译完成，按 Enter 发送');
+  } catch (error) {
+    toast(error instanceof Error ? error.message : '翻译失败', true);
+  } finally {
+    busy.delete(target);
+  }
+}
+
+document.addEventListener('keydown', event => {
+  if (!editable(event.target) || event.isComposing || event.keyCode === 229) return;
+  if (event.altKey && event.key.toLowerCase() === 't') {
+    event.preventDefault();
+    void translateComposer(event.target);
+  } else if (event.key === ' ' && !event.shiftKey && / {2}$/.test(read(event.target))) {
+    event.preventDefault();
+    void translateComposer(event.target);
+  }
+}, true);
+
+function incomingBubble(candidate) {
+  if (candidate.closest('.message-out')) return null;
+  const whatsapp = candidate.closest('.message-in,[data-testid="msg-container"]');
+  if (whatsapp?.querySelector('[data-pre-plain-text]')) return whatsapp;
+  const telegram = candidate.closest('.Message.message-list-item,.message');
+  if (!telegram || telegram.matches('.own,.is-outgoing,.message-out') || telegram.classList.contains('own')) return null;
+  return telegram;
+}
+
+function bubbleText(node) {
+  const textNode = node.querySelector('[data-pre-plain-text],.text-content,.message-content,.copyable-text');
+  if (!textNode) return '';
+  const clone = textNode.cloneNode(true);
+  clone.querySelectorAll('.caisheng-message-translation').forEach(child => child.remove());
+  return clone.innerText?.trim() || clone.textContent?.trim() || '';
+}
+
+async function translateBubble(node) {
+  if (translated.has(node)) return;
+  const original = bubbleText(node);
+  if (!original || original.length > 30000 || /^https?:\/\/\S+$/i.test(original) || !/[\p{L}\p{Script=Han}]/u.test(original)) return;
+  translated.add(node);
+  try {
+    const result = await requestTranslation(original);
+    if (!node.isConnected) return;
+    const line = document.createElement('div');
+    line.className = 'caisheng-message-translation';
+    line.textContent = result;
+    line.title = '财盛自动翻译 · 双击复制';
+    Object.assign(line.style, { color: '#1687ff', fontSize: '13px', lineHeight: '1.55', borderTop: '1px dashed #1687ff44', marginTop: '5px', paddingTop: '4px', whiteSpace: 'pre-wrap' });
+    line.ondblclick = event => { event.stopPropagation(); void navigator.clipboard.writeText(result); toast('译文已复制'); };
+    (node.querySelector('.copyable-text,.text-content,.message-content') || node).append(line);
+  } catch {
+    translated.delete(node);
+  }
+}
+
+function scan(root) {
+  if (!(root instanceof Document || root instanceof Element)) return;
+  root.querySelectorAll('[data-pre-plain-text],.Message.message-list-item,.message').forEach(candidate => {
+    const bubble = incomingBubble(candidate);
+    if (bubble) void translateBubble(bubble);
+  });
+}
+
+window.addEventListener('DOMContentLoaded', () => {
+  scan(document);
+  new MutationObserver(records => records.forEach(record => record.addedNodes.forEach(node => {
+    if (node instanceof Element) { const bubble = incomingBubble(node); if (bubble) void translateBubble(bubble); scan(node); }
+  }))).observe(document.body, { childList: true, subtree: true });
+});
