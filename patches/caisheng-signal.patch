+    );
+    assert.equal(parseCaishengWorkspacePartition(partition)?.workspaceId, id);
+  });
+
+  it('rejects malformed partitions', () => {
+    assert.isUndefined(parseCaishengWorkspacePartition('persist:default'));
+    assert.isUndefined(
+      parseCaishengWorkspacePartition(
+        'persist:caisheng-whatsapp-../../default'
+      ) == null
+    );
+  });
+});
