+
+import { assert } from 'chai';
+
+import {
+  getCaishengPlatforms,
+  getDefaultCaishengPlatform,
+  getEnabledCaishengPlatforms,
+} from '../../services/caishengPlatform.std.ts';
+
+describe('Caisheng platform permissions', () => {
+  it('only enables platforms granted to the user', () => {
+    const platforms = getCaishengPlatforms({
+      signalEnabled: false,
+      whatsappEnabled: true,
+      telegramEnabled: false,
+    });
+
+    assert.deepEqual(
+      getEnabledCaishengPlatforms(platforms).map(item => item.id),
+      ['whatsapp']
+    );
+  });
+
+  it('selects the first enabled platform as the default', () => {
+    const platforms = getCaishengPlatforms({
+      signalEnabled: false,
+      whatsappEnabled: true,
+      telegramEnabled: true,
+    });
+
+    assert.equal(getDefaultCaishengPlatform(platforms), 'whatsapp');
+  });
+
+  it('has no default when the user has no platform permission', () => {
+    const platforms = getCaishengPlatforms({
+      signalEnabled: false,
+      whatsappEnabled: false,
+      telegramEnabled: false,
+    });
+
+    assert.isUndefined(getDefaultCaishengPlatform(platforms));
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' '--exclude=release' a/ts/test-node/services/caishengTranslation_test.node.ts b/ts/test-node/services/caishengTranslation_test.node.ts
--- a/ts/test-node/services/caishengTranslation_test.node.ts	1969-12-31 18:00:00.000000000 -0600
+++ b/ts/test-node/services/caishengTranslation_test.node.ts	2026-09-05 00:18:15.103871324 -0500
@@ -0,0 +1,50 @@
+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import { assert } from 'chai';
+
+import {
+  getCaishengProviderOrder,
+  getCaishengTargetLanguage,
+  type CaishengTranslationSettings,
+} from '../../services/caishengTranslation.dom.ts';
+
+describe('Caisheng translation', () => {
+  it('translates Chinese messages to English', () => {
+    assert.equal(getCaishengTargetLanguage('你好，订单 123'), 'en');
+  });
+
+  it('translates non-Chinese messages to Chinese', () => {
+    assert.equal(getCaishengTargetLanguage('Hello, order 123'), 'zh-CN');
+    assert.equal(getCaishengTargetLanguage('こんにちは'), 'zh-CN');
+  });
+
+  it('handles mixed text as Chinese input', () => {
+    assert.equal(getCaishengTargetLanguage('Signal 消息'), 'en');
+  });
+
+  it('uses free providers in deterministic fallback order', () => {
+    const settings = { provider: 'auto', libreEndpoint: '' } as CaishengTranslationSettings;
+    assert.deepEqual(getCaishengProviderOrder(settings), ['google-free', 'mymemory']);
+    assert.deepEqual(getCaishengProviderOrder({ ...settings, libreEndpoint: 'https://libre.example' }), ['google-free', 'mymemory', 'libre']);
+  });
+
+  it('does not fall back when a provider is explicitly selected', () => {
+    const settings = { provider: 'microsoft' } as CaishengTranslationSettings;
+    assert.deepEqual(getCaishengProviderOrder(settings), ['microsoft']);
+  });
+
+  it('prefers a configured AI provider for accurate translation', () => {
+    const settings = {
+      provider: 'auto',
+      apiKey: 'configured',
+      compatibleEndpoint: '',
+      libreEndpoint: '',
+    } as CaishengTranslationSettings;
+    assert.deepEqual(getCaishengProviderOrder(settings), [
+      'openai',
+      'google-free',
+      'mymemory',
+    ]);
+  });
+});
