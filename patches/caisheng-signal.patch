+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+const CAISHENG_SUPABASE_URL = 'https://ffnvtyadqizvrikjjssy.supabase.co';
+const CAISHENG_SUPABASE_PUBLISHABLE_KEY =
+  'sb_publishable_hVl7mHSjPJYEuaMCrOjYbw_KG0Y4QjO';
+
+export type CaishengUser = Readonly<{
+  id: string;
+  username: string;
+  displayName: string;
+  role: 'admin' | 'agent' | 'employee';
+  maxDevices: number;
+  whatsappEnabled: boolean;
+  signalEnabled: boolean;
+  telegramEnabled: boolean;
+  providers: ReadonlyArray<'google' | 'deepl' | 'openai'>;
+}>;
+
+export type CaishengSession = Readonly<{
+  access_token: string;
+  expires_at?: number;
+  refresh_token?: string;
+}>;
+
+export type CaishengLoginResult = Readonly<{
+  ok: true;
+  session: CaishengSession;
+  user: CaishengUser;
+}>;
+
+export async function loginToCaisheng(
+  username: string,
+  password: string
+): Promise<CaishengLoginResult> {
+  const response = await fetch(
+    `${CAISHENG_SUPABASE_URL}/functions/v1/username-login`,
+    {
+      method: 'POST',
+      headers: {
+        apikey: CAISHENG_SUPABASE_PUBLISHABLE_KEY,
+        'Content-Type': 'application/json',
+      },
+      body: JSON.stringify({ username: username.trim(), password }),
+    }
+  );
+  const body = await response.json();
+  if (!response.ok) {
+    throw new Error(body.error ?? '登录失败');
+  }
+  return body as CaishengLoginResult;
+}
diff -ruN '--exclude=node_modules' '--exclude=release' '--exclude=.cache' '--exclude=*.log' a/ts/services/caishengTranslation.dom.ts b/ts/services/caishengTranslation.dom.ts
--- a/ts/services/caishengTranslation.dom.ts	1969-12-31 18:00:00.000000000 -0600
+++ b/ts/services/caishengTranslation.dom.ts	2026-09-04 16:00:14.399061845 -0500
@@ -0,0 +1,121 @@
+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+export type CaishengTranslationProvider = 'google' | 'openai';
+
+export type CaishengTranslationSettings = Readonly<{
+  provider: CaishengTranslationProvider;
+  apiKey: string;
+  targetLanguage: string;
+  openAIModel: string;
+  autoTranslateIncoming: boolean;
+}>;
+
+const SETTINGS_KEY = 'caisheng.translation.settings.v1';
+
+const DEFAULT_SETTINGS: CaishengTranslationSettings = {
+  provider: 'openai',
+  apiKey: '',
+  targetLanguage: 'zh-CN',
+  openAIModel: 'gpt-4.1-mini',
+  autoTranslateIncoming: true,
+};
+
+export function getCaishengTargetLanguage(text: string): 'en' | 'zh-CN' {
+  return /[\u3400-\u9fff]/u.test(text) ? 'en' : 'zh-CN';
+}
+
+export function loadCaishengTranslationSettings(): CaishengTranslationSettings {
+  try {
+    const saved = JSON.parse(localStorage.getItem(SETTINGS_KEY) ?? '{}');
+    return { ...DEFAULT_SETTINGS, ...saved };
+  } catch {
+    return DEFAULT_SETTINGS;
+  }
+}
+
+export function saveCaishengTranslationSettings(
+  settings: CaishengTranslationSettings
+): void {
+  localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
+}
+
+async function translateWithOpenAI(
+  text: string,
+  settings: CaishengTranslationSettings
+): Promise<string> {
+  const response = await fetch('https://api.openai.com/v1/responses', {
+    method: 'POST',
+    headers: {
+      Authorization: `Bearer ${settings.apiKey}`,
+      'Content-Type': 'application/json',
+    },
+    body: JSON.stringify({
+      model: settings.openAIModel,
+      instructions: [
+        'You are a precision business-chat translator.',
+        'Translate faithfully without adding explanations or omitting content.',
+        'Preserve names, usernames, phone numbers, amounts, currencies, URLs, emojis, line breaks, and tone.',
+        'Keep ambiguous wording ambiguous instead of guessing.',
+        'Return only the translated text.',
+      ].join(' '),
+      input: `Target language: ${settings.targetLanguage}\n\n${text}`,
+    }),
+  });
+
+  if (!response.ok) {
+    throw new Error(`OpenAI translation failed (${response.status})`);
+  }
+
+  const data = await response.json();
+  const output = data.output
+    ?.flatMap(
+      (item: { content?: Array<{ text?: string }> }) => item.content ?? []
+    )
+    .map((item: { text?: string }) => item.text ?? '')
+    .join('')
+    .trim();
+  if (!output) {
+    throw new Error('OpenAI returned an empty translation');
+  }
+  return output;
+}
+
+async function translateWithGoogle(
+  text: string,
+  settings: CaishengTranslationSettings
+): Promise<string> {
+  const endpoint = new URL(
+    'https://translation.googleapis.com/language/translate/v2'
+  );
+  endpoint.searchParams.set('key', settings.apiKey);
+  const response = await fetch(endpoint, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ q: text, target: settings.targetLanguage }),
+  });
+  if (!response.ok) {
+    throw new Error(`Google translation failed (${response.status})`);
+  }
+  const data = await response.json();
+  const output = data.data?.translations?.[0]?.translatedText?.trim();
+  if (!output) {
+    throw new Error('Google returned an empty translation');
+  }
+  return output;
+}
+
+export async function translateCaishengText(
+  text: string,
+  settings: CaishengTranslationSettings
+): Promise<string> {
+  if (!text.trim()) {
+    throw new Error('请输入要翻译的内容');
+  }
+  if (!settings.apiKey.trim()) {
+    throw new Error('请先填写翻译 API Key');
+  }
+  return settings.provider === 'google'
+    ? translateWithGoogle(text, settings)
+    : translateWithOpenAI(text, settings);
+}
