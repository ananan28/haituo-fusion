+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import { useCallback, useEffect, useState, type JSX } from 'react';
+import {
+  getCaishengTargetLanguage,
+  loadCaishengTranslationSettings,
+  translateCaishengText,
+} from '../../services/caishengTranslation.dom.ts';
+
+export function CaishengMessageTranslation({
+  text,
+}: Readonly<{ text: string }>): JSX.Element {
+  const [translated, setTranslated] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+
+  const translate = useCallback(async (): Promise<void> => {
+    setBusy(true);
+    setError('');
+    try {
+      const settings = loadCaishengTranslationSettings();
+      const targetLanguage = getCaishengTargetLanguage(text);
+      setTranslated(
+        await translateCaishengText(text, { ...settings, targetLanguage })
+      );
+    } catch (reason) {
+      setError(reason instanceof Error ? reason.message : '翻译失败');
+    } finally {
+      setBusy(false);
+    }
+  }, [text]);
+
+  useEffect(() => {
+    const settings = loadCaishengTranslationSettings();
+    if (!settings.autoTranslateIncoming) {
+      return;
+    }
+    void translate();
+  }, [text, translate]);
+
+  const handleButton = useCallback(() => {
+    if (translated) {
+      setTranslated('');
+    } else {
+      void translate();
+    }
+  }, [translate, translated]);
+
+  return (
+    <span className="CaishengMessageTranslation">
+      <button disabled={busy} type="button" onClick={handleButton}>
+        {busy ? '自动翻译中…' : translated ? '隐藏翻译' : '翻译'}
+      </button>
+      {translated ? (
+        <span className="CaishengMessageTranslation__result">{translated}</span>
+      ) : null}
+      {error ? (
+        <span className="CaishengMessageTranslation__error">{error}</span>
+      ) : null}
+    </span>
+  );
+}
