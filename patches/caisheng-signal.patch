+
+import { assert } from 'chai';
+import {
+  createCaishengWorkspaceId,
+  getCaishengWorkspacePartition,
+  parseCaishengWorkspacePartition,
+} from '../../services/caishengWorkspace.std.ts';
+
+describe('caishengWorkspace', () => {
+  it('creates a stable, isolated account partition', () => {
+    const id = createCaishengWorkspaceId('whatsapp', 'Account_01');
+    const partition = getCaishengWorkspacePartition({
+      id,
+      platformId: 'whatsapp',
+    });
+    assert.equal(
+      partition,
