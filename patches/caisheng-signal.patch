diff -ruN '--exclude=node_modules' '--exclude=.git' a/ts/services/caishengTranslation.dom.ts b/ts/services/caishengTranslation.dom.ts
--- a/ts/services/caishengTranslation.dom.ts	1969-12-31 18:00:00.000000000 -0600
+++ b/ts/services/caishengTranslation.dom.ts	2026-09-04 20:13:35.619415321 -0500
@@ -0,0 +1,121 @@
+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+export type CaishengTranslationProvider = 'auto' | 'google-free' | 'mymemory' | 'libre' | 'microsoft' | 'openai' | 'qwen' | 'glm';
+export type CaishengTranslationSettings = Readonly<{
+  provider: CaishengTranslationProvider; apiKey: string; targetLanguage: string;
+  openAIModel: string; autoTranslateIncoming: boolean; libreEndpoint: string;
+  microsoftRegion: string; compatibleEndpoint: string; timeoutMs: number;
+}>;
+
+const SETTINGS_KEY = 'caisheng.translation.settings.v1';
+const CACHE_LIMIT = 300;
+const translationCache = new Map<string, string>();
+const DEFAULT_SETTINGS: CaishengTranslationSettings = {
+  provider: 'auto', apiKey: '', targetLanguage: 'zh-CN', openAIModel: 'gpt-4.1-mini',
+  autoTranslateIncoming: true, libreEndpoint: '', microsoftRegion: '', compatibleEndpoint: '', timeoutMs: 10000,
+};
+
+export function getCaishengTargetLanguage(text: string): 'en' | 'zh-CN' {
+  return /[\u3400-\u9fff]/u.test(text) ? 'en' : 'zh-CN';
+}
+export function loadCaishengTranslationSettings(): CaishengTranslationSettings {
+  try {
+    const saved = JSON.parse(localStorage.getItem(SETTINGS_KEY) ?? '{}');
+    if (saved.provider === 'google') saved.provider = 'auto';
+    return { ...DEFAULT_SETTINGS, ...saved };
+  } catch { return DEFAULT_SETTINGS; }
+}
+export function saveCaishengTranslationSettings(settings: CaishengTranslationSettings): void {
+  localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
+}
+export function getCaishengProviderOrder(settings: CaishengTranslationSettings): ReadonlyArray<CaishengTranslationProvider> {
+  if (settings.provider !== 'auto') return [settings.provider];
+  return settings.libreEndpoint.trim() ? ['google-free', 'mymemory', 'libre'] : ['google-free', 'mymemory'];
+}
+function normalizeError(provider: string, reason: unknown): Error {
+  if (reason instanceof DOMException && reason.name === 'AbortError') return new Error(`${provider} 请求超时`);
+  const message = reason instanceof Error ? reason.message : String(reason);
+  return new Error(`${provider} 翻译失败：${message || '未知错误'}`);
+}
+async function requestJson(provider: string, url: string, init: RequestInit, timeoutMs: number) {
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), timeoutMs);
+  try {
+    const response = await fetch(url, { ...init, signal: controller.signal });
+    if (!response.ok) throw new Error(`HTTP ${response.status}`);
+    return await response.json();
+  } catch (reason) { throw normalizeError(provider, reason); }
+  finally { clearTimeout(timer); }
+}
+async function googleFree(text: string, target: string, timeout: number): Promise<string> {
+  const url = new URL('https://translate.googleapis.com/translate_a/single');
+  Object.entries({ client: 'gtx', sl: 'auto', tl: target, dt: 't', q: text }).forEach(([key, value]) => url.searchParams.set(key, value));
+  const data = await requestJson('Google', url.href, {}, timeout);
+  return (data?.[0] ?? []).map((part: unknown[]) => part?.[0] ?? '').join('').trim();
+}
+async function myMemory(text: string, target: string, timeout: number): Promise<string> {
+  const source = getCaishengTargetLanguage(text) === 'en' ? 'zh-CN' : 'en';
+  const url = new URL('https://api.mymemory.translated.net/get');
+  url.searchParams.set('q', text); url.searchParams.set('langpair', `${source}|${target}`);
+  const data = await requestJson('MyMemory', url.href, {}, timeout);
+  if (Number(data?.responseStatus ?? 200) >= 400) throw new Error(`MyMemory 翻译失败：${data.responseDetails || data.responseStatus}`);
+  return data?.responseData?.translatedText?.trim() ?? '';
+}
+async function libre(text: string, settings: CaishengTranslationSettings): Promise<string> {
+  if (!settings.libreEndpoint.trim()) throw new Error('LibreTranslate 未配置服务地址');
+  const data = await requestJson('LibreTranslate', `${settings.libreEndpoint.replace(/\/$/u, '')}/translate`, {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ q: text, source: 'auto', target: settings.targetLanguage, ...(settings.apiKey ? { api_key: settings.apiKey } : {}) }),
+  }, settings.timeoutMs);
+  return data?.translatedText?.trim() ?? '';
+}
+async function microsoft(text: string, settings: CaishengTranslationSettings): Promise<string> {
+  if (!settings.apiKey.trim()) throw new Error('微软翻译需要配置 API Key');
+  const url = new URL('https://api.cognitive.microsofttranslator.com/translate');
+  url.searchParams.set('api-version', '3.0'); url.searchParams.set('to', settings.targetLanguage);
+  const data = await requestJson('微软', url.href, {
+    method: 'POST', headers: { 'Content-Type': 'application/json', 'Ocp-Apim-Subscription-Key': settings.apiKey,
+      ...(settings.microsoftRegion ? { 'Ocp-Apim-Subscription-Region': settings.microsoftRegion } : {}) },
+    body: JSON.stringify([{ Text: text }]),
+  }, settings.timeoutMs);
+  return data?.[0]?.translations?.[0]?.text?.trim() ?? '';
+}
+async function compatibleAI(text: string, settings: CaishengTranslationSettings, provider: 'openai' | 'qwen' | 'glm'): Promise<string> {
+  if (!settings.apiKey.trim()) throw new Error(`${provider.toUpperCase()} 需要配置 API Key`);
+  const base = settings.compatibleEndpoint.trim() || (provider === 'openai' ? 'https://api.openai.com/v1' : '');
+  if (!base) throw new Error(`${provider.toUpperCase()} 需要配置兼容 API 地址`);
+  const defaults = { openai: 'gpt-4.1-mini', qwen: 'Qwen3-8B', glm: 'GLM-4-9B' };
+  const data = await requestJson(provider.toUpperCase(), `${base.replace(/\/$/u, '')}/chat/completions`, {
+    method: 'POST', headers: { Authorization: `Bearer ${settings.apiKey}`, 'Content-Type': 'application/json' },
+    body: JSON.stringify({ model: settings.openAIModel || defaults[provider], temperature: 0, messages: [
+      { role: 'system', content: 'Translate faithfully. Preserve names, numbers, URLs, emojis, line breaks and tone. Return only the translation.' },
+      { role: 'user', content: `Target language: ${settings.targetLanguage}\n\n${text}` },
+    ] }),
+  }, settings.timeoutMs);
+  return data?.choices?.[0]?.message?.content?.trim() ?? '';
+}
+async function withProvider(text: string, settings: CaishengTranslationSettings, provider: CaishengTranslationProvider): Promise<string> {
+  if (provider === 'google-free') return googleFree(text, settings.targetLanguage, settings.timeoutMs);
+  if (provider === 'mymemory') return myMemory(text, settings.targetLanguage, settings.timeoutMs);
+  if (provider === 'libre') return libre(text, settings);
+  if (provider === 'microsoft') return microsoft(text, settings);
+  if (provider === 'openai' || provider === 'qwen' || provider === 'glm') return compatibleAI(text, settings, provider);
+  throw new Error('不支持的翻译服务');
+}
+export async function translateCaishengText(text: string, settings: CaishengTranslationSettings): Promise<string> {
+  if (!text.trim()) throw new Error('请输入要翻译的内容');
+  const key = `${settings.provider}\u0000${settings.targetLanguage}\u0000${text}`;
+  const cached = translationCache.get(key); if (cached) return cached;
+  const errors: string[] = [];
+  for (const provider of getCaishengProviderOrder(settings)) {
+    try {
+      const output = await withProvider(text, settings, provider);
+      if (!output) throw new Error('返回内容为空');
+      translationCache.set(key, output);
+      if (translationCache.size > CACHE_LIMIT) translationCache.delete(translationCache.keys().next().value as string);
+      return output;
+    } catch (reason) { errors.push(reason instanceof Error ? reason.message : String(reason)); }
+  }
+  throw new Error(errors.join('；'));
+}
