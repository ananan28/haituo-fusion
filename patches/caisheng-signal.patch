+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+@use '../variables';
+
+.CaishengLogin {
+  display: grid;
+  width: 100vw;
+  height: 100vh;
+  place-items: center;
+  background: linear-gradient(145deg, #111827, #1d4ed8);
+
+  &__box {
+    display: flex;
+    width: min(380px, calc(100vw - 40px));
+    flex-direction: column;
+    gap: 14px;
+    padding: 32px;
+    border-radius: 18px;
+    background: variables.$color-white;
+    box-shadow: 0 24px 80px rgb(0 0 0 / 32%);
+
+    h1,
+    p {
+      margin: 0;
+      text-align: center;
+    }
+
+    label {
+      display: flex;
+      flex-direction: column;
+      gap: 6px;
+      font-weight: 600;
+    }
+
+    input,
+    button {
+      min-height: 42px;
+      border: 1px solid variables.$color-gray-20;
+      border-radius: 8px;
+      padding: 8px 12px;
+      font: inherit;
+    }
+
+    button {
+      border: 0;
+      background: #2563eb;
+      color: variables.$color-white;
+      cursor: pointer;
+      font-weight: 700;
+
+      &:disabled {
+        cursor: wait;
+        opacity: 0.65;
+      }
+    }
+
+    small {
+      color: variables.$color-gray-60;
+      text-align: center;
+    }
+  }
+
+  &__brand {
+    display: grid;
+    width: 64px;
+    height: 64px;
+    margin: 0 auto;
+    place-items: center;
+    border-radius: 50%;
+    background: #f59e0b;
+    color: #111827;
+    font-size: 20px;
+    font-weight: 900;
+  }
+
+  &__error {
+    color: variables.$color-accent-red;
+    text-align: center;
+  }
+}
