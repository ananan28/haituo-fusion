+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+export type CaishengTripleSpaceAction = Readonly<{
+  shouldTranslate: boolean;
+  sourceText: string;
+}>;
+
+// Called before Quill inserts the third space. Two trailing spaces therefore
+// mean that this key press is the triple-space translation shortcut.
+export function getCaishengTripleSpaceAction(
+  currentText: string
+): CaishengTripleSpaceAction {
+  if (!currentText.endsWith('  ')) {
+    return { shouldTranslate: false, sourceText: currentText };
+  }
+
+  const sourceText = currentText.slice(0, -2).trimEnd();
+  return { shouldTranslate: sourceText.length > 0, sourceText };
+}
