+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import { ipcMain } from 'electron';
+
+const ALLOWED_HOSTS = new Set(['web.whatsapp.com', 'web.telegram.org']);
+
+function assertAllowedSender(url: string): void {
+  let hostname = '';
+  try {
+    hostname = new URL(url).hostname;
+  } catch {
+    // Rejected below.
+  }
+  if (!ALLOWED_HOSTS.has(hostname)) {
+    throw new Error('不允许的翻译请求来源');
+  }
+}
+
+export function installCaishengWebviewTranslation(): void {
+  ipcMain.removeHandler('caisheng:webview-translate');
+  ipcMain.handle(
+    'caisheng:webview-translate',
+    async (event, value: unknown, target: unknown) => {
+      assertAllowedSender(event.senderFrame?.url ?? '');
+      const text = typeof value === 'string' ? value.trim() : '';
+      const targetLanguage = target === 'en' ? 'en' : 'zh-CN';
+      if (!text || text.length > 30000) {
+        throw new Error('翻译内容为空或过长');
+      }
+      const url = new URL(
+        'https://translate.googleapis.com/translate_a/single'
+      );
+      url.search = new URLSearchParams({
+        client: 'gtx',
+        sl: 'auto',
+        tl: targetLanguage,
+        dt: 't',
+        q: text,
+      }).toString();
+      const response = await fetch(url, {
+        signal: AbortSignal.timeout(20000),
+      });
+      if (!response.ok) {
+        throw new Error(`翻译服务连接失败（${response.status}）`);
+      }
+      const body = (await response.json()) as ReadonlyArray<
+        ReadonlyArray<ReadonlyArray<unknown>>
+      >;
+      const translated = body[0]
+        ?.map(part => (typeof part?.[0] === 'string' ? part[0] : ''))
+        .join('')
+        .trim();
+      if (!translated) {
+        throw new Error('翻译服务未返回结果');
+      }
+      return { text: translated };
+    }
+  );
+}
