+const CAISHENG_LOGIN_URL =
+  "https://ffnvtyadqizvrikjjssy.supabase.co/functions/v1/username-login";
+const CAISHENG_SUPABASE_PUBLISHABLE_KEY =
+  "sb_publishable_hVl7mHSjPJYEuaMCrOjYbw_KG0Y4QjO";
+const CaishengLoginCredentialsSchema = z.object({
+  username: z.string().trim().min(1).max(128),
+  password: z.string().regex(/^\d{6}$/),
+  proxyUrl: z.string().trim().max(256).optional(),
+});
+const CaishengLoginResponseSchema = z.object({
+  ok: z.literal(true),
+  session: z.object({
+    access_token: z.string().min(1),
+    expires_at: z.number().optional(),
+    refresh_token: z.string().optional(),
+  }),
+  user: z.object({
+    id: z.string().min(1),
+    username: z.string(),
+    displayName: z.string(),
+    role: z.enum(["admin", "agent", "employee"]),
+    maxDevices: z.number(),
+    whatsappEnabled: z.boolean(),
+    signalEnabled: z.boolean(),
+    telegramEnabled: z.boolean(),
+    providers: z.array(z.enum(["google", "deepl", "openai"])),
+  }),
+});
+
+function getCaishengLoginError(body: unknown, fallback: string): string {
+  if (body && typeof body === "object") {
+    const { error, message } = body as {
+      error?: unknown;
+      message?: unknown;
+    };
+    if (typeof error === "string" && error) {
+      return error;
+    }
+    if (typeof message === "string" && message) {
+      return message;
+    }
+  }
+  return fallback;
+}
+
+ipc.handle("caisheng:login", async (_event, input: unknown) => {
+  const credentials = CaishengLoginCredentialsSchema.safeParse(input);
+  if (!credentials.success) {
+    return {
+      ok: false,
+      code: "INVALID_REQUEST",
+      error: "账号或密码格式不正确",
+    } satisfies CaishengLoginIpcResult;
+  }
+
+  const controller = new AbortController();
+  const timeout = setTimeout(() => controller.abort(), 15_000);
+  try {
+    const proxyUrl = credentials.data.proxyUrl;
+    if (proxyUrl) {
+      if (!/^(https?|socks5):\/\//i.test(proxyUrl)) {
+        return {
+          ok: false,
+          code: "INVALID_REQUEST",
+          error: "代理地址必须以 http://、https:// 或 socks5:// 开头",
+        } satisfies CaishengLoginIpcResult;
+      }
+      await session.defaultSession.setProxy({
+        mode: "fixed_servers",
+        proxyRules: proxyUrl,
+      });
+    } else {
+      await session.defaultSession.setProxy({ mode: "system" });
+    }
+    await session.defaultSession.closeAllConnections();
+    const response = await net.fetch(CAISHENG_LOGIN_URL, {
+      method: "POST",
+      headers: {
+        Accept: "application/json",
+        apikey: CAISHENG_SUPABASE_PUBLISHABLE_KEY,
+        Authorization: `Bearer ${CAISHENG_SUPABASE_PUBLISHABLE_KEY}`,
+        "Content-Type": "application/json",
+      },
+      body: JSON.stringify(credentials.data),
+      signal: controller.signal,
+    });
+
+    const text = await response.text();
+    let body: unknown;
+    try {
+      body = text ? JSON.parse(text) : undefined;
+    } catch {
+      body = undefined;
+    }
+
+    if (!response.ok) {
+      return {
+        ok: false,
+        code: "SERVER_ERROR",
+        error: getCaishengLoginError(
+          body,
+          `登录服务器错误 (${response.status})`,
+        ),
+      } satisfies CaishengLoginIpcResult;
+    }
+
+    const parsed = CaishengLoginResponseSchema.safeParse(body);
+    if (!parsed.success) {
+      return {
+        ok: false,
+        code: "SERVER_ERROR",
+        error: "登录服务器返回的数据不完整",
+      } satisfies CaishengLoginIpcResult;
+    }
+    return parsed.data satisfies CaishengLoginIpcResult;
+  } catch (error) {
+    return {
+      ok: false,
+      code: "NETWORK_ERROR",
+      error:
+        error instanceof Error && error.name === "AbortError"
+          ? "连接登录服务器超时，请稍后重试"
+          : "无法连接登录服务器，请检查网络或代理设置",
+    } satisfies CaishengLoginIpcResult;
+  } finally {
+    clearTimeout(timeout);
+  }
+});
