@@ -0,0 +1,75 @@
+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import type { CaishengPlatformId } from './caishengPlatformRegistry.std.ts';
+
+export type CaishengWorkspaceId = string;
+
+export type CaishengWorkspace = Readonly<{
+  id: CaishengWorkspaceId;
+  platformId: CaishengPlatformId;
+  /** Human-readable account note shown in the tab. */
+  label: string;
+  /** Data URL or app-managed file URL; never sent to the service. */
+  iconUrl?: string;
+  createdAt: number;
+}>;
+
+const SAFE_ID = /^[a-z0-9][a-z0-9_-]{0,63}$/;
+
+export function isValidCaishengWorkspaceId(value: string): boolean {
+  return SAFE_ID.test(value);
+}
+
+export function createCaishengWorkspaceId(
+  platformId: CaishengPlatformId,
+  randomId: string
+): CaishengWorkspaceId {
+  const normalized = randomId.toLowerCase().replace(/[^a-z0-9_-]/g, '');
+  if (!normalized || normalized.length > 48) {
+    throw new Error('Invalid workspace random id');
+  }
+  return `${platformId}-${normalized}`;
+}
+
+/**
+ * Every account gets an Electron persistent session. Cookies, IndexedDB,
+ * CacheStorage and service workers are isolated by this partition.
+ */
+export function getCaishengWorkspacePartition(
+  workspace: Pick<CaishengWorkspace, 'id' | 'platformId'>
+): string {
+  if (!isValidCaishengWorkspaceId(workspace.id)) {
+    throw new Error('Invalid workspace id');
+  }
+  if (!workspace.id.startsWith(`${workspace.platformId}-`)) {
+    throw new Error('Workspace id does not match platform');
+  }
+  return `persist:caisheng-${workspace.id}`;
+}
+
+export function parseCaishengWorkspacePartition(
+  partition: string
+): Readonly<{ platformId: CaishengPlatformId; workspaceId: string }> | undefined {
+  const match = /^persist:caisheng-(signal|whatsapp|telegram)-([a-z0-9][a-z0-9_-]{0,47})$/.exec(
+    partition
+  );
+  if (!match) {
+    return undefined;
+  }
+  return {
+    platformId: match[1] as CaishengPlatformId,
+    workspaceId: `${match[1]}-${match[2]}`,
+  };
+}
+
+export function renameCaishengWorkspace(
+  workspace: CaishengWorkspace,
+  label: string
+): CaishengWorkspace {
+  const normalized = label.trim().slice(0, 40);
+  if (!normalized) {
+    throw new Error('Workspace label cannot be empty');
+  }
+  return { ...workspace, label: normalized };
+}
