diff -ruN '--exclude=node_modules' '--exclude=.git' '--exclude=release' a/ts/components/CaishengAuthGate.dom.tsx b/ts/components/CaishengAuthGate.dom.tsx
--- a/ts/components/CaishengAuthGate.dom.tsx	1969-12-31 18:00:00.000000000 -0600
+++ b/ts/components/CaishengAuthGate.dom.tsx	2026-09-04 20:52:15.321802775 -0500
@@ -0,0 +1,134 @@
+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import {
+  createContext,
+  useContext,
+  useMemo,
+  useState,
+  type FormEvent,
+  type JSX,
+  type ReactNode,
+} from 'react';
+import {
+  loginToCaisheng,
+  type CaishengLoginResult,
+} from '../services/caishengAuth.dom.ts';
+
+const CaishengAuthContext = createContext<CaishengLoginResult | null>(null);
+
+export function useCaishengAuth(): CaishengLoginResult {
+  const value = useContext(CaishengAuthContext);
+  if (!value) {
+    throw new Error('Caisheng authentication is not ready');
+  }
+  return value;
+}
+
+export function CaishengAuthGate({
+  children,
+}: Readonly<{ children: ReactNode }>): JSX.Element {
+  const [login, setLogin] = useState<CaishengLoginResult | null>(null);
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [proxyUrl, setProxyUrl] = useState('');
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState(false);
+
+  const context = useMemo(() => login, [login]);
+
+  async function submit(event: FormEvent<HTMLFormElement>): Promise<void> {
+    event.preventDefault();
+    if (!username.trim()) {
+      setError('请输入中文账号');
+      return;
+    }
+    if (!/^\d{6}$/.test(password)) {
+      setError('密码必须是六位数字');
+      return;
+    }
+
+    setBusy(true);
+    setError('');
+    try {
+      setLogin(await loginToCaisheng(username, password, proxyUrl.trim() || undefined));
+    } catch (reason) {
+      const message = reason instanceof Error ? reason.message : '登录失败';
+      setError(
+        message === 'Failed to fetch'
+          ? '无法连接登录服务器，请检查网络后重试'
+          : message
+      );
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  if (context) {
+    if (!context.user.signalEnabled) {
+      return (
+        <main className="CaishengLogin">
+          <section className="CaishengLogin__box">
+            <div className="CaishengLogin__brand">财盛</div>
+            <h1>Signal 未授权</h1>
+            <p>当前账号没有使用 Signal 的权限，请联系管理员开启。</p>
+            <button type="button" onClick={() => setLogin(null)}>
+              返回登录
+            </button>
+          </section>
+        </main>
+      );
+    }
+    return (
+      <CaishengAuthContext.Provider value={context}>
+        {children}
+      </CaishengAuthContext.Provider>
+    );
+  }
+
+  return (
+    <main className="CaishengLogin">
+      <form className="CaishengLogin__box" onSubmit={submit}>
+        <div className="CaishengLogin__brand">财盛</div>
+        <h1>财盛技术部内供翻译</h1>
+        <p>企业多账号翻译工作台</p>
+        <label>
+          中文账号
+          <input
+            autoFocus
+            autoComplete="username"
+            value={username}
+            onChange={event => setUsername(event.target.value)}
+          />
+        </label>
+        <label>
+          六位密码
+          <input
+            autoComplete="current-password"
+            inputMode="numeric"
+            maxLength={6}
+            type="password"
+            value={password}
+            onChange={event =>
+              setPassword(event.target.value.replace(/\D/g, '').slice(0, 6))
+            }
+          />
+        </label>
+        <label>
+          代理地址（无法连接时填写）
+          <input
+            autoComplete="off"
+            placeholder="例如 http://127.0.0.1:7890"
+            value={proxyUrl}
+            onChange={event => setProxyUrl(event.target.value)}
+          />
+        </label>
+        {error ? <div className="CaishengLogin__error">{error}</div> : null}
+        <button disabled={busy} type="submit">
+          {busy ? '正在登录…' : '安全登录'}
+        </button>
+        <small>登录只使用财盛内部账号，不接收 Supabase 管理密码</small>
+      </form>
+    </main>
+  );
+}
diff -ruN '--exclude=node_modules' '--exclude=.git' '--exclude=release' a/ts/components/CaishengComposerTranslator.dom.tsx b/ts/components/CaishengComposerTranslator.dom.tsx
--- a/ts/components/CaishengComposerTranslator.dom.tsx	1969-12-31 18:00:00.000000000 -0600
+++ b/ts/components/CaishengComposerTranslator.dom.tsx	2026-09-04 20:13:13.234848933 -0500
@@ -0,0 +1,158 @@
+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import { useCallback, useState, type JSX } from 'react';
+import {
+  loadCaishengTranslationSettings,
+  saveCaishengTranslationSettings,
+  translateCaishengText,
+  type CaishengTranslationProvider,
+} from '../services/caishengTranslation.dom.ts';
+
+export type CaishengComposerTranslatorProps = Readonly<{
+  disabled: boolean;
+  text: string;
+  onApplyTranslation: (translatedText: string) => void;
+  onSendTranslation: (translatedText: string) => void;
+}>;
+
+export function CaishengComposerTranslator({
+  disabled,
+  text,
+  onApplyTranslation,
+  onSendTranslation,
+}: CaishengComposerTranslatorProps): JSX.Element {
+  const [settings, setSettings] = useState(loadCaishengTranslationSettings);
+  const [showSettings, setShowSettings] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+
+  const update = useCallback(
+    (next: Partial<typeof settings>) => {
+      const value = { ...settings, ...next };
+      setSettings(value);
+      saveCaishengTranslationSettings(value);
+    },
+    [settings]
+  );
+
+  const run = useCallback(
+    async (send: boolean) => {
+      setBusy(true);
+      setError('');
+      try {
+        const translated = await translateCaishengText(text, settings);
+        if (send) {
+          onSendTranslation(translated);
+        } else {
+          onApplyTranslation(translated);
+        }
+      } catch (reason) {
+        setError(reason instanceof Error ? reason.message : '翻译失败');
+      } finally {
+        setBusy(false);
+      }
+    },
+    [onApplyTranslation, onSendTranslation, settings, text]
+  );
+
+  return (
+    <div className="CaishengComposerTranslator">
+      <div className="CaishengComposerTranslator__toolbar">
+        <strong>财盛翻译</strong>
+        <select
+          aria-label="目标语言"
+          value={settings.targetLanguage}
+          onChange={event => update({ targetLanguage: event.target.value })}
+        >
+          <option value="zh-CN">中文</option>
+          <option value="en">English</option>
+          <option value="ja">日本語</option>
+          <option value="ko">한국어</option>
+          <option value="es">Español</option>
+        </select>
+        <button type="button" onClick={() => setShowSettings(value => !value)}>
+          API 设置
+        </button>
+        <button
+          type="button"
+          disabled={disabled || busy}
+          onClick={() => void run(false)}
+        >
+          {busy ? '翻译中…' : '翻译'}
+        </button>
+        <button
+          type="button"
+          disabled={disabled || busy}
+          onClick={() => void run(true)}
+        >
+          翻译后发送
+        </button>
+      </div>
+      {showSettings ? (
+        <div className="CaishengComposerTranslator__settings">
+          <select
+            aria-label="翻译服务"
+            value={settings.provider}
+            onChange={event =>
+              update({
+                provider: event.target.value as CaishengTranslationProvider,
+              })
+            }
+          >
+            <option value="auto">自动选择（免费优先）</option>
+            <option value="google-free">Google 免费公共翻译</option>
+            <option value="mymemory">MyMemory 免费翻译</option>
+            <option value="libre">LibreTranslate</option>
+            <option value="microsoft">微软翻译（需配置）</option>
+            <option value="openai">OpenAI（需配置）</option>
+            <option value="qwen">Qwen3-8B（需配置）</option>
+            <option value="glm">GLM-4-9B（需配置）</option>
+          </select>
+          <input
+            aria-label="翻译 API Key"
+            type="password"
+            value={settings.apiKey}
+            placeholder="API Key（仅保存在本机）"
+            onChange={event => update({ apiKey: event.target.value })}
+          />
+          {settings.provider === 'openai' ? (
+            <input
+              aria-label="OpenAI 模型"
+              value={settings.openAIModel}
+              onChange={event => update({ openAIModel: event.target.value })}
+            />
+          ) : null}
+          {settings.provider === 'libre' ? (
+            <input aria-label="LibreTranslate 服务地址" value={settings.libreEndpoint}
+              placeholder="https://你的-libretranslate-服务"
+              onChange={event => update({ libreEndpoint: event.target.value })} />
+          ) : null}
+          {settings.provider === 'microsoft' ? (
+            <input aria-label="微软翻译区域" value={settings.microsoftRegion}
+              placeholder="Azure 区域（如 eastasia）"
+              onChange={event => update({ microsoftRegion: event.target.value })} />
+          ) : null}
+          {settings.provider === 'qwen' || settings.provider === 'glm' ? (
+            <input aria-label="OpenAI 兼容 API 地址" value={settings.compatibleEndpoint}
+              placeholder="OpenAI 兼容 API 地址"
+              onChange={event => update({ compatibleEndpoint: event.target.value })} />
+          ) : null}
+          <label>
+            <input
+              checked={settings.autoTranslateIncoming}
+              type="checkbox"
+              onChange={event =>
+                update({ autoTranslateIncoming: event.target.checked })
+              }
+            />
+            自动翻译收到的消息
+          </label>
+        </div>
+      ) : null}
+      {error ? (
+        <div className="CaishengComposerTranslator__error">{error}</div>
+      ) : null}
+    </div>
+  );
+}
diff -ruN '--exclude=node_modules' '--exclude=.git' '--exclude=release' a/ts/components/CaishengPlatformShell.dom.tsx b/ts/components/CaishengPlatformShell.dom.tsx
--- a/ts/components/CaishengPlatformShell.dom.tsx	1969-12-31 18:00:00.000000000 -0600
+++ b/ts/components/CaishengPlatformShell.dom.tsx	2026-09-05 00:22:09.393522790 -0500
@@ -0,0 +1,415 @@
+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+import {
+  createElement,
+  useMemo,
+  useRef,
+  useState,
+  type ChangeEvent,
+  type HTMLAttributes,
+  type JSX,
+  type MouseEvent,
+  type ReactNode,
+} from "react";
+import { useCaishengAuth } from "./CaishengAuthGate.dom.tsx";
+import {
+  getCaishengPlatformAdapter,
+  type CaishengPlatformId,
+} from "../services/caishengPlatformRegistry.std.ts";
+import {
+  createCaishengWorkspaceId,
+  getCaishengWorkspacePartition,
+  isValidCaishengWorkspaceId,
+  renameCaishengWorkspace,
+  type CaishengWorkspace,
+} from "../services/caishengWorkspace.std.ts";
+
+const STORAGE_KEY = "caisheng.workspaces.v3";
+const TRANSLATION_SETTINGS_KEY = "caisheng.translation.settings.v1";
+const SIGNAL: CaishengWorkspace = {
+  id: "signal-main",
+  platformId: "signal",
+  label: "Signal",
+  createdAt: 0,
+};
+type Menu = Readonly<{ id: string; x: number; y: number }>;
+function loadEfficiencyMode(): boolean {
+  try {
+    const value: unknown = JSON.parse(
+      localStorage.getItem(TRANSLATION_SETTINGS_KEY) ?? "{}",
+    );
+    return Boolean(
+      value &&
+        typeof value === "object" &&
+        (value as { efficiencyMode?: unknown }).efficiencyMode,
+    );
+  } catch {
+    return false;
+  }
+}
+function allowed(
+  id: CaishengPlatformId,
+  user: ReturnType<typeof useCaishengAuth>["user"],
+): boolean {
+  return id === "signal"
+    ? user.signalEnabled
+    : id === "whatsapp"
+      ? user.whatsappEnabled
+      : user.telegramEnabled;
+}
+function load(): ReadonlyArray<CaishengWorkspace> {
+  try {
+    const raw: unknown = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "[]");
+    if (!Array.isArray(raw)) return [SIGNAL];
+    return [
+      SIGNAL,
+      ...raw.filter((entry): entry is CaishengWorkspace => {
+        if (!entry || typeof entry !== "object") return false;
+        const item = entry as Partial<CaishengWorkspace>;
+        return (
+          typeof item.id === "string" &&
+          isValidCaishengWorkspaceId(item.id) &&
+          (item.platformId === "whatsapp" || item.platformId === "telegram") &&
+          typeof item.label === "string" &&
+          Boolean(item.label.trim()) &&
+          typeof item.createdAt === "number" &&
+          (item.iconUrl === undefined ||
+            (typeof item.iconUrl === "string" &&
+              item.iconUrl.startsWith("data:image/")))
+        );
+      }),
+    ];
+  } catch {
+    return [SIGNAL];
+  }
+}
+
+export function CaishengPlatformShell({
+  signal,
+}: Readonly<{ signal: ReactNode }>): JSX.Element {
+  const { user } = useCaishengAuth();
+  const [items, setItemsState] = useState(load);
+  const [active, setActive] = useState("signal-main");
+  const [adding, setAdding] = useState(false);
+  const [showSettings, setShowSettings] = useState(false);
+  const [efficiencyMode, setEfficiencyMode] = useState(loadEfficiencyMode);
+  const [menu, setMenu] = useState<Menu>();
+  const [iconTarget, setIconTarget] = useState<string>();
+  const iconInput = useRef<HTMLInputElement>(null);
+  const selected = useMemo(
+    () => items.find((item) => item.id === menu?.id),
+    [items, menu],
+  );
+  function changeEfficiencyMode(next: boolean): void {
+    let settings: Record<string, unknown> = {};
+    try {
+      const saved: unknown = JSON.parse(
+        localStorage.getItem(TRANSLATION_SETTINGS_KEY) ?? "{}",
+      );
+      if (saved && typeof saved === "object") {
+        settings = saved as Record<string, unknown>;
+      }
+    } catch {
+      // Replace corrupt settings with a valid object.
+    }
+    localStorage.setItem(
+      TRANSLATION_SETTINGS_KEY,
+      JSON.stringify({ ...settings, efficiencyMode: next }),
+    );
+    setEfficiencyMode(next);
+  }
+  const setItems = (
+    fn: (
+      value: ReadonlyArray<CaishengWorkspace>,
+    ) => ReadonlyArray<CaishengWorkspace>,
+  ): void => {
+    setItemsState((current) => {
+      const next = fn(current);
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
+      return next;
+    });
+  };
+  const patchItem = (
+    id: string,
+    patch: Pick<Partial<CaishengWorkspace>, "label" | "iconUrl">,
+  ): void =>
+    setItems((current) =>
+      current.map((item) => (item.id === id ? { ...item, ...patch } : item)),
+    );
+  function add(platformId: "whatsapp" | "telegram"): void {
+    if (!allowed(platformId, user)) return;
+    const id = createCaishengWorkspaceId(
+      platformId,
+      crypto.randomUUID().replaceAll("-", ""),
+    );
+    const count =
+      items.filter((item) => item.platformId === platformId).length + 1;
+    setItems((current) => [
+      ...current,
+      {
+        id,
+        platformId,
+        label: `${getCaishengPlatformAdapter(platformId).label} ${count}`,
+        createdAt: Date.now(),
+      },
+    ]);
+    setActive(id);
+    setAdding(false);
+  }
+  function rename(item: CaishengWorkspace): void {
+    const label = prompt("账号备注", item.label);
+    if (label === null) return;
+    try {
+      patchItem(item.id, { label: renameCaishengWorkspace(item, label).label });
+    } catch {
+      alert("备注不能为空");
+    }
+    setMenu(undefined);
+  }
+  function chooseIcon(item: CaishengWorkspace): void {
+    setIconTarget(item.id);
+    iconInput.current?.click();
+    setMenu(undefined);
+  }
+  function iconChanged(event: ChangeEvent<HTMLInputElement>): void {
+    const file = event.target.files?.[0];
+    event.target.value = "";
+    if (!file || !iconTarget) return;
+    if (!file.type.startsWith("image/") || file.size > 256 * 1024) {
+      alert("请选择 256KB 以内的图片");
+      return;
+    }
+    const reader = new FileReader();
+    reader.onload = () => {
+      if (typeof reader.result === "string")
+        patchItem(iconTarget, { iconUrl: reader.result });
+    };
+    reader.readAsDataURL(file);
+  }
+  async function clear(item: CaishengWorkspace): Promise<void> {
+    if (
+      item.platformId === "signal" ||
+      !confirm(`清除 ${item.label} 的登录状态和缓存？`)
+    )
+      return;
+    await window.SignalContext.caishengClearWorkspaceData(
+      getCaishengWorkspacePartition(item),
+    );
+    setMenu(undefined);
+    alert("缓存已清除");
+  }
+  function remove(item: CaishengWorkspace): void {
+    if (item.platformId === "signal" || !confirm(`删除 ${item.label}？`))
+      return;
+    setItems((current) => current.filter((value) => value.id !== item.id));
+    if (active === item.id) setActive("signal-main");
+    setMenu(undefined);
+  }
+  function context(
+    event: MouseEvent<HTMLButtonElement>,
+    item: CaishengWorkspace,
+  ): void {
+    event.preventDefault();
+    event.stopPropagation();
+    setMenu({
+      id: item.id,
+      x: Math.min(event.clientX, innerWidth - 190),
+      y: Math.min(event.clientY, innerHeight - 230),
+    });
+  }
+  return (
+    <div
+      className="CaishengPlatformShell"
+      onClick={() => {
+        setMenu(undefined);
+        setAdding(false);
+        setShowSettings(false);
+      }}
+    >
+      <nav className="CaishengPlatformShell__nav" aria-label="财盛多账号工作台">
+        <strong>财盛翻译</strong>
+        <div className="CaishengPlatformShell__tabs">
+          {items
+            .filter((item) => allowed(item.platformId, user))
+            .map((item) => (
+              <button
+                aria-pressed={active === item.id}
+                className={active === item.id ? "is-active" : undefined}
+                key={item.id}
+                onClick={() => setActive(item.id)}
+                onContextMenu={(event) => context(event, item)}
+                title={`${item.label} · 右键管理`}
+                type="button"
+              >
+                {item.iconUrl ? (
+                  <img
+                    className="CaishengPlatformShell__icon"
+                    src={item.iconUrl}
+                    alt=""
+                  />
+                ) : (
+                  <span
+                    className={`CaishengPlatformShell__iconFallback is-${item.platformId}`}
+                  >
+                    {item.platformId === "whatsapp"
+                      ? "W"
+                      : item.platformId === "telegram"
+                        ? "T"
+                        : "S"}
+                  </span>
+                )}
+                <span>{item.label}</span>
+              </button>
+            ))}
+        </div>
+        <button
+          aria-expanded={adding}
+          className="CaishengPlatformShell__add"
+          onClick={(event) => {
+            event.stopPropagation();
+            setAdding((value) => !value);
+          }}
+          type="button"
+        >
+          ＋
+        </button>
+        <button
+          aria-expanded={showSettings}
+          aria-label="翻译设置"
+          className="CaishengPlatformShell__settingsButton"
+          onClick={(event) => {
+            event.stopPropagation();
+            setShowSettings((value) => !value);
+          }}
+          type="button"
+        >
+          ⚙
+        </button>
+        {adding ? (
+          <div
+            className="CaishengPlatformShell__picker"
+            onClick={(event) => event.stopPropagation()}
+          >
+            <button
+              disabled={!user.whatsappEnabled}
+              onClick={() => add("whatsapp")}
+              type="button"
+            >
+              新增 WhatsApp
+            </button>
+            <button
+              disabled={!user.telegramEnabled}
+              onClick={() => add("telegram")}
+              type="button"
+            >
+              新增 Telegram
+            </button>
+          </div>
+        ) : null}
+        {showSettings ? (
+          <div
+            className="CaishengPlatformShell__settings"
+            onClick={(event) => event.stopPropagation()}
+          >
+            <label>
+              <input
+                checked={efficiencyMode}
+                onChange={(event) => changeEfficiencyMode(event.target.checked)}
+                type="checkbox"
+              />
+              <span>
+                <strong>效率模式</strong>
+                <small>Enter 翻译并发送，Shift+Enter 换行</small>
+              </span>
+            </label>
+            <p>普通模式下仍可连续按三次空格翻译。</p>
+          </div>
+        ) : null}
+        <input
+          ref={iconInput}
+          hidden
+          accept="image/png,image/jpeg,image/webp"
+          onChange={iconChanged}
+          type="file"
+        />
+      </nav>
+      {selected && menu ? (
+        <div
+          className="CaishengPlatformShell__context"
+          onClick={(event) => event.stopPropagation()}
+          style={{ left: menu.x, top: menu.y }}
+        >
+          <button onClick={() => rename(selected)} type="button">
+            编辑备注
+          </button>
+          <button onClick={() => chooseIcon(selected)} type="button">
+            上传图标
+          </button>
+          {selected.iconUrl ? (
+            <button
+              onClick={() => {
+                patchItem(selected.id, { iconUrl: undefined });
+                setMenu(undefined);
+              }}
+              type="button"
+            >
+              恢复默认图标
+            </button>
+          ) : null}
+          {selected.platformId !== "signal" ? (
+            <>
+              <button
+                onClick={() => {
+                  setActive(selected.id);
+                  setMenu(undefined);
+                }}
+                type="button"
+              >
+                打开账号
+              </button>
+              <button onClick={() => void clear(selected)} type="button">
+                清除缓存
+              </button>
+              <button
+                className="is-danger"
+                onClick={() => remove(selected)}
+                type="button"
+              >
+                删除账号
+              </button>
+            </>
+          ) : null}
+        </div>
+      ) : null}
+      <section className="CaishengPlatformShell__content">
+        <div
+          hidden={active !== "signal-main"}
+          className="CaishengPlatformShell__signal"
+        >
+          {signal}
+        </div>
+        {items
+          .filter(
+            (item) =>
+              item.platformId !== "signal" && allowed(item.platformId, user),
+          )
+          .map((item) => {
+            const adapter = getCaishengPlatformAdapter(item.platformId);
+            if (!adapter.startUrl) return null;
+            return createElement("webview", {
+              className: "CaishengPlatformShell__webview",
+              hidden: active !== item.id,
+              key: item.id,
+              partition: getCaishengWorkspacePartition(item),
+              src: adapter.startUrl,
+              useragent: navigator.userAgent,
+            } as HTMLAttributes<HTMLElement> & {
+              partition: string;
+              src: string;
+              useragent: string;
+            });
+          })}
+      </section>
+    </div>
+  );
+}
