+    );
+    assert.isFalse(
+      !isAllowedCaishengPlatformUrl(
+        'whatsapp',
+        'https://web.whatsapp.com.attacker.example/'
+      )
+    );
+  });
+
+  it('rejects unknown platform ids', () => {
+    assert.isTrue(isCaishengPlatformId('telegram'));
+    assert.isFalse(isCaishengPlatformId('unknown'));
+  });
+});
