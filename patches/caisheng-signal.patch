diff -ruN '--exclude=node_modules' '--exclude=.git' '--exclude=release' a/ts/services/caishengPlatformRegistry.std.ts b/ts/services/caishengPlatformRegistry.std.ts
--- a/ts/services/caishengPlatformRegistry.std.ts	1969-12-31 18:00:00.000000000 -0600
