+$ErrorActionPreference = 'Stop'
+
+Write-Host 'Building Caisheng Signal for Windows...'
+
+if (-not (Get-Command corepack -ErrorAction SilentlyContinue)) {
+  throw 'Node.js with Corepack is required.'
+}
+
+corepack enable
+corepack pnpm install --frozen-lockfile
+corepack pnpm run check:types
+corepack pnpm run test-node -- --grep 'Caisheng translation'
+corepack pnpm run build-win32-all
+
+Write-Host 'Build complete. Check the release directory.'
