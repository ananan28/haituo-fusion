+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import { assert } from 'chai';
+
+import { getCaishengTripleSpaceAction } from '../../services/caishengComposer.std.ts';
+
+describe('Caisheng triple-space shortcut', () => {
+  it('triggers before the third space is inserted', () => {
+    assert.deepEqual(getCaishengTripleSpaceAction('hello  '), {
+      shouldTranslate: true,
+      sourceText: 'hello',
+    });
+  });
+
+  it('does not trigger for fewer than two trailing spaces', () => {
+    assert.isFalse(getCaishengTripleSpaceAction('hello ').shouldTranslate);
+    assert.isFalse(getCaishengTripleSpaceAction('hello').shouldTranslate);
+  });
+
+  it('does not translate an empty composer', () => {
+    assert.deepEqual(getCaishengTripleSpaceAction('  '), {
+      shouldTranslate: false,
+      sourceText: '',
+    });
+  });
+
+  it('supports non-breaking spaces used by rich text editors', () => {
+    assert.deepEqual(getCaishengTripleSpaceAction('你好\u00a0\u00a0'), {
+      shouldTranslate: true,
+      sourceText: '你好',
+    });
+  });
+
+  it('supports multiline composer text', () => {
+    assert.deepEqual(getCaishengTripleSpaceAction('第一行\n第二行  '), {
+      shouldTranslate: true,
+      sourceText: '第一行\n第二行',
+    });
+  });
+});
