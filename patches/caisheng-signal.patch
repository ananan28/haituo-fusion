+// Copyright 2026 Caisheng
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import { createElement, useEffect, useState, type HTMLAttributes, type JSX, type ReactNode } from 'react';
+
+type Workspace = Readonly<{
+  id: string;
+  platform: 'signal' | 'whatsapp' | 'telegram';
+  label: string;
+  url?: string;
+}>;
+
+const STORAGE_KEY = 'caisheng.workspaces.v2';
+const DEFAULT_WORKSPACES: ReadonlyArray<Workspace> = [
+  { id: 'signal-main', platform: 'signal', label: 'Signal' },
+  { id: 'whatsapp-1', platform: 'whatsapp', label: 'WhatsApp 1', url: 'https://web.whatsapp.com/' },
+  { id: 'telegram-1', platform: 'telegram', label: 'Telegram 1', url: 'https://web.telegram.org/k/' },
+];
+
+function loadWorkspaces(): ReadonlyArray<Workspace> {
+  try {
+    const value = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? 'null');
+    return Array.isArray(value) && value.length ? value : DEFAULT_WORKSPACES;
+  } catch {
+    return DEFAULT_WORKSPACES;
+  }
+}
+
+export function CaishengPlatformShell({ signal }: Readonly<{ signal: ReactNode }>): JSX.Element {
+  const [workspaces, setWorkspaces] = useState(loadWorkspaces);
+  const [activeId, setActiveId] = useState(workspaces[0]?.id ?? 'signal-main');
+
+  useEffect(() => {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(workspaces));
+    if (!workspaces.some(item => item.id === activeId)) {
+      setActiveId(workspaces[0]?.id ?? 'signal-main');
+    }
+  }, [activeId, workspaces]);
+
+  function addWorkspace(): void {
+    const answer = window.prompt('输入 1 添加 WhatsApp，输入 2 添加 Telegram', '1');
+    const platform = answer === '2' ? 'telegram' : answer === '1' ? 'whatsapp' : null;
+    if (!platform) return;
+    const id = `${platform}-${Date.now()}`;
+    const count = workspaces.filter(item => item.platform === platform).length + 1;
+    const item: Workspace = {
+      id,
+      platform,
+      label: `${platform === 'whatsapp' ? 'WhatsApp' : 'Telegram'} ${count}`,
+      url: platform === 'whatsapp' ? 'https://web.whatsapp.com/' : 'https://web.telegram.org/k/',
+    };
+    setWorkspaces(current => [...current, item]);
+    setActiveId(id);
+  }
+
+  function renameWorkspace(item: Workspace): void {
+    const label = window.prompt('账号备注', item.label)?.trim();
+    if (!label) return;
+    setWorkspaces(current =>
+      current.map(value => value.id === item.id ? { ...value, label } : value)
+    );
+  }
+
+  function removeWorkspace(item: Workspace): void {
+    if (item.platform === 'signal') return;
+    setWorkspaces(current => current.filter(value => value.id !== item.id));
+  }
+
+  return (
+    <div className="CaishengPlatformShell">
+      <nav className="CaishengPlatformShell__nav" aria-label="财盛多账号翻译工作台">
+        <strong>财盛翻译</strong>
+        {workspaces.map(item => (
+          <span className="CaishengPlatformShell__tab" key={item.id}>
+            <button
+              aria-pressed={activeId === item.id}
+              className={activeId === item.id ? 'is-active' : undefined}
+              onClick={() => setActiveId(item.id)}
+              onDoubleClick={() => renameWorkspace(item)}
+              title="双击修改备注"
+              type="button"
+            >
+              {item.label}
+            </button>
+            {item.platform !== 'signal' ? (
+              <button
+                aria-label={`删除 ${item.label}`}
+                className="CaishengPlatformShell__remove"
+                onClick={() => removeWorkspace(item)}
+                type="button"
+              >
+                ×
+              </button>
+            ) : null}
+          </span>
+        ))}
+        <button className="CaishengPlatformShell__add" onClick={addWorkspace} type="button">
+          ＋
+        </button>
+      </nav>
+      <section className="CaishengPlatformShell__content">
+        <div hidden={activeId !== 'signal-main'} className="CaishengPlatformShell__signal">
+          {signal}
+        </div>
+        {workspaces
+          .filter(item => item.platform !== 'signal' && item.url)
+          .map(item =>
+            createElement('webview', {
+              className: 'CaishengPlatformShell__webview',
+              hidden: activeId !== item.id,
+              key: item.id,
+              partition: `persist:caisheng-${item.id}`,
+              src: item.url,
+            } as HTMLAttributes<HTMLElement> & { partition: string; src: string })
+          )}
+      </section>
+    </div>
+  );
+}
