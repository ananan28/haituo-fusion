{
  "name": "caisheng-multichat",
  "version": "0.2.0",
  "private": true,
  "description": "财盛聚合聊天独立平台",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/service-preload.js && node --check src/translation.js && node --check src/renderer/app.js",
    "test": "npm run check && node --test test/*.test.js"
  },
  "devDependencies": {
    "electron": "38.1.2",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.caisheng.multichat",
    "productName": "财盛聚合聊天",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "财盛聚合聊天-安装版-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "财盛聚合聊天"
    },
    "portable": {
      "artifactName": "财盛聚合聊天-便携版-${version}-${arch}.${ext}"
    }
  }
}
